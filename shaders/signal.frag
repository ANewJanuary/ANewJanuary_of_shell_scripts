// p in font pixels (glyph = 5x7, advance 6), origin bottom-left of the line.
// One glyph, q in font pixels inside its 6x7 cell.
float glyphPix(vec2 q, int g) {
    int col = int(q.x), row = 6 - int(q.y);
    if (col < 0 || col > 4 || row < 0 || row > 6) return 0.0;
    return float((FONT[g * 5 + col] >> uint(row)) & 1u);
}
float textLine(vec2 p, int start, int len) {
    if (p.y < 0.0 || p.y >= 7.0 || p.x < 0.0 || p.x >= float(len) * 6.0) return 0.0;
    int ci = int(p.x) / 6;
    return glyphPix(vec2(p.x - float(ci * 6), p.y), TXT[start + ci]);
}
// @endgen

// ---- helpers -----------------------------------------------------------
float h11(float n) { return fract(sin(n * 127.1) * 43758.5453); }
float h21(vec2 p)  { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

vec2  R;        // resolution
float S;        // screen px per design unit (design = 1080 tall)
float FP;       // screen px per font pixel (integer, keeps text crisp)
float px;       // one screen pixel in design units

float fill(float d) { return clamp(0.5 - d / px, 0.0, 1.0); }   // AA fill of an SDF
float sdBox(vec2 p, vec2 b) { vec2 d = abs(p) - b; return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0); }
float sdSeg(vec2 p, vec2 a, vec2 b) { vec2 pa = p - a, ba = b - a; return length(pa - ba * clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)); }

// Text at a design-space origin (bottom-left), snapped to the pixel grid.
float txt(vec2 frag, vec2 o, int start, int len, int shown) {
    vec2 q = floor((frag - floor(o * S)) / FP);
    return textLine(q, start, min(len, max(shown, 0)));
}
// Typed text: appears at time t0 within a looping block.
int typed(float t, float t0) { return int((t - t0) * TYPE_SPEED); }

// n-digit integer readout
float num(vec2 frag, vec2 o, int v, int n) {
    vec2 q = floor((frag - floor(o * S)) / FP);
    if (q.y < 0.0 || q.y >= 7.0 || q.x < 0.0 || q.x >= float(n * 6)) return 0.0;
    int ci = int(q.x) / 6, d = v;
    for (int i = 0; i < n - 1 - ci; i++) d /= 10;
    return glyphPix(vec2(q.x - float(ci * 6), q.y), TXT[T_DIG + d % 10]);
}
// one glyph from the PUNCT line
float punct(vec2 frag, vec2 o, int k) {
    vec2 q = floor((frag - floor(o * S)) / FP);
    return glyphPix(q, TXT[T_PUNCT + k]);
}

// ---- shapes ------------------------------------------------------------
// Keyhole emblem: disc with an off-centre hole and a slot to the bottom.
float emblem(vec2 p, float r) {
    float d = length(p) - r;
    float hole = length(p - vec2(0.0, 0.14 * r)) - 0.61 * r;
    float slot = sdBox(p - vec2(0.0, -0.6 * r), vec2(0.135 * r, 0.6 * r));
    return max(d, -min(hole, slot));
}
// Chunky up-right arrow, s = size of the bounding square.
float arrow(vec2 p, float s) {
    float th = s * 0.2;
    float top   = sdBox(p - vec2(0.15 * s, 0.5 * s - th * 0.5), vec2(0.35 * s, th * 0.5));
    float right = sdBox(p - vec2(0.5 * s - th * 0.5, 0.15 * s), vec2(th * 0.5, 0.35 * s));
    vec2 q = p - vec2(0.5 * s - th * 0.5, 0.5 * s - th * 0.5);
    vec2 r = vec2(q.x + q.y, q.y - q.x) * 0.7071;          // rotate 45deg
    float bar = sdBox(r - vec2(-0.5 * s, 0.0), vec2(0.5 * s, th * 0.5));
    bar = max(bar, max(q.x, q.y) - th * 0.5);
    float d = min(min(top, right), bar);
    return d + 0.0;
}
float noEntry(vec2 p, float r) {
    float ring = abs(length(p) - r) - r * 0.13;
    float bar  = sdSeg(p, vec2(-0.6, 0.6) * r * 1.0, vec2(0.6, -0.6) * r * 1.0) - r * 0.13;
    return min(ring, max(bar, length(p) - r));
}
float triIcon(vec2 p, float s) {   // outlined left-pointing triangle with a dash
    vec2 a = vec2(-s, 0.0), b = vec2(s, s * 0.75), c = vec2(s, -s * 0.75);
    float o = min(min(sdSeg(p, a, b), sdSeg(p, b, c)), sdSeg(p, c, a)) - s * 0.09;
    float dash = sdBox(p - vec2(s * 0.3, 0.0), vec2(s * 0.35, s * 0.08));
    return min(o, dash);
}
// plus / crosshair
float plus(vec2 p, float s, float w) { return min(sdBox(p, vec2(s, w)), sdBox(p, vec2(w, s))); }

// Dot field inside a box: grey dots on a grid, a few lit, one scanning.
vec3 dotField(vec3 col, vec2 p, vec2 lo, vec2 hi, float step, float seed, float t) {
    if (any(lessThan(p, lo - step)) || any(greaterThan(p, hi + step))) return col;
    vec2 g = floor((p - lo) / step + 0.5);
    vec2 n = floor((hi - lo) / step + 0.5);
    if (any(lessThan(g, vec2(0))) || any(greaterThan(g, n))) return col;
    vec2 c = lo + g * step;
    float id = h21(g + seed);
    float scan = mod(floor(t * 4.0) + seed, (n.x + 1.0) * (n.y + 1.0));
    bool lit = id > 0.93 || (g.y * (n.x + 1.0) + g.x) == scan;
    float r = lit ? 2.6 : 1.5;
    // little 3x3 micro-grids at the corners of the field
    bool corner = (g.x == 0.0 || g.x == n.x) && (g.y == 0.0 || g.y == n.y) && id > 0.4;
    if (corner) {
        vec2 m = abs(fract((p - c) / 3.2 + 0.5) - 0.5) * 3.2;
        float in3 = step * 0.0 + max(abs(p - c).x, abs(p - c).y);
        return mix(col, GREY, fill(max(length(m) - 0.9, in3 - 5.0)));
    }
    return mix(col, lit ? LIME : GREY, fill(length(p - c) - r));
}

// ---- main --------------------------------------------------------------
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    R = iResolution.xy;
    S = R.y / 1080.0;
    px = 1.0 / S;
    FP = max(1.0, floor(R.y / 720.0 + 0.5));
    float W = R.x / S;                 // design width
    float t = iTime;

    // glitch: rare bursts that shift horizontal bands
    float gb = floor(t / GLITCH_EVERY);
    float gs = gb * GLITCH_EVERY + h11(gb) * (GLITCH_EVERY - 1.0);
    float glitch = step(gs, t) * step(t, gs + 0.35);
    vec2 frag = fragCoord;
    if (glitch > 0.0) {
        float band = floor(frag.y / (R.y * (0.02 + 0.06 * h11(gb + 3.0))));
        float k = h21(vec2(band, floor(t * 20.0)));
        if (k > 0.7) frag.x += (k - 0.85) * R.x * 0.12;
    }
    vec2 p = frag / S;                 // design coords, y up

    vec3 col = BG;

    // dot fields
    col = dotField(col, p, vec2(W - 680.0, 905.0), vec2(W - 320.0, 1040.0), 45.0, 1.0, t);
    col = dotField(col, p, vec2(160.0, 640.0), vec2(390.0, 820.0), 45.0, 7.0, t);
    col = dotField(col, p, vec2(W - 460.0, 75.0), vec2(W - 120.0, 195.0), 40.0, 3.0, t);

    vec3 lime = LIME;
    float ink = 0.0;   // lime mask
    float dim = 0.0;   // grey mask

    // --- top-left status block (loops every 24 s)
    float tb = mod(t, 24.0);
    float ty = 1040.0, lh = 13.0 * FP / S;   // line height in design units
    if (tb < 21.0) {
        ink += txt(fragCoord, vec2(14.0, ty),          T_CORES, N_CORES, typed(tb, 0.0));
        ink += txt(fragCoord, vec2(14.0, ty - lh),     T_SYSOV, N_SYSOV, typed(tb, 0.6));
        ink += txt(fragCoord, vec2(14.0, ty - 2.*lh),  T_NNET,  N_NNET,  typed(tb, 1.0));
        ink += txt(fragCoord, vec2(14.0, ty - 3.*lh),  T_RO1,   N_RO1,   typed(tb, 1.8));

        float x2 = 220.0;
        ink += txt(fragCoord, vec2(x2, ty),           T_STRACE, N_STRACE, typed(tb, 2.4));
        ink += txt(fragCoord, vec2(x2 + 16., ty - lh),    T_CV,   N_CV,   typed(tb, 3.0));
        ink += txt(fragCoord, vec2(x2 + 16., ty - 2.*lh), T_LD,   N_LD,   typed(tb, 3.8));
        ink += txt(fragCoord, vec2(x2 + 16., ty - 3.*lh), T_SYNC, N_SYNC, typed(tb, 4.5));
        ink += txt(fragCoord, vec2(x2 + 16., ty - 4.*lh), T_MISM, N_MISM, typed(tb, 5.2));
        ink += txt(fragCoord, vec2(x2 + 16., ty - 6.*lh), T_WARN, N_WARN, typed(tb, 6.4));
        ink += txt(fragCoord, vec2(x2 + 16., ty - 7.*lh), T_INFO, N_INFO, typed(tb, 7.3));
        ink += txt(fragCoord, vec2(x2 + 16., ty - 8.*lh), T_FAIL, N_FAIL, typed(tb, 8.2));
        // blinking "running diagnostic..."
        if (tb > 9.5 && fract(t * 1.2) < 0.7)
            ink += txt(fragCoord, vec2(x2 + 16., ty - 10.*lh), T_RUN, N_RUN, typed(tb, 9.5));
    }

    // --- left: dot icon + triangle + ids
    {
        vec2 o = vec2(30.0, 655.0);
        vec2 g = clamp(floor((p - o) / 16.0 + 0.5), 0.0, 2.0);
        float on = step(0.15, h21(g + floor(t * 1.5)));
        ink += on * fill(length(p - o - g * 16.0) - 5.5);
        ink += fill(triIcon(p - vec2(118.0, 671.0), 18.0));
        ink += txt(fragCoord, vec2(150.0, 676.0), T_ID1, N_ID1, 99);
        ink += txt(fragCoord, vec2(150.0, 676.0 - lh), T_ID2, N_ID2, 99);
    }

    // --- big arrow, top right, with a twitchy number row below
    {
        float s = 190.0;
        vec2 c = vec2(W - 30.0 - s * 0.5, 1050.0 - s * 0.5);
        float jump = step(0.92, h11(floor(t * 3.0) + 11.0));        // occasional nudge
        ink += fill(arrow(p - c - vec2(jump * 6.0, jump * 6.0), s) - 6.0) ;
        for (int i = 0; i < 8; i++) {
            float x = W - 460.0 + float(i) * 55.0 + h11(float(i)) * 20.0;
            int v = int(h11(float(i) * 3.1 + floor(t * 0.7 + h11(float(i)))) * (i % 3 == 0 ? 99.0 : 9.99));
            ink += num(fragCoord, vec2(x, 828.0), v, v > 9 ? 2 : 1);
        }
    }

    // --- centre emblem
    {
        vec2 c = vec2(W * 0.5, 545.0);
        vec2 q = p - c;
        // split glitch: halves slide apart briefly
        float sb = floor(t / 11.0), st = mod(t, 11.0);
        float split = smoothstep(0.0, 0.05, st - 9.0) * (1.0 - smoothstep(0.25, 0.3, st - 9.0));
        q.x += sign(q.y - 10.0) * split * 18.0;
        float e = emblem(q, 155.0);
        ink += fill(e);
        // thin registration ring that ticks around the emblem
        float ang = atan(q.y, q.x);
        float seg = step(0.5, fract(ang / 6.2832 * 48.0 + floor(t * 2.0) / 48.0));
        dim += seg * fill(abs(length(q) - 200.0) - 0.8) * step(length(q), 230.0);
    }

    // --- right middle: no-entry + sync-way list
    {
        vec2 c = vec2(W - 640.0, 635.0);
        ink += fill(noEntry(p - c, 26.0));
        float x = c.x + 40.0, y = 652.0;
        for (int i = 0; i < 4; i++) {
            vec2 o = vec2(x, y - float(i) * lh);
            ink += txt(fragCoord, o, T_SWAY, N_SWAY, 99);
            ink += num(fragCoord, o + vec2(float(N_SWAY * 6) * FP / S, 0.0), i + 1, 1);
            ink += txt(fragCoord, o + vec2(float((N_SWAY + 2) * 6) * FP / S, 0.0), T_DOTS, N_DOTS, 99);
            float st = h11(float(i) * 7.7 + floor(t / 3.0 + float(i) * 0.37));
            vec2 so = o + vec2(float((N_SWAY + 8) * 6) * FP / S, 0.0);
            if (st < 0.4)      ink += txt(fragCoord, so, T_STD, N_STD, 99);
            else if (st < 0.6) ink += txt(fragCoord, so, T_STR, N_STR, 99);
            else if (st < 0.8) ink += txt(fragCoord, so, T_STO, N_STO, 99);
            else               ink += txt(fragCoord, so, T_STS, N_STS, 99);
        }
        // little square + code
        vec2 sq = vec2(W - 170.0, 640.0);
        ink += fill(sdBox(p - sq, vec2(9.0)));
        ink += num(fragCoord, sq + vec2(18.0, -6.0), 74, 2);
        ink += punct(fragCoord, sq + vec2(18.0 + 12.0 * FP / S, -6.0), 2);
        ink += num(fragCoord, sq + vec2(18.0 + 18.0 * FP / S, -6.0), 300 + int(h11(floor(t)) * 99.0), 3);
    }

    // --- block of logs on the right, scrolls in at a slow pace
    {
        float x = W - 640.0;
        float y0 = 775.0;
        float tb2 = mod(t + 9.0, 18.0);
        ink += txt(fragCoord, vec2(x, y0),          T_SNR, N_SNR, typed(tb2, 0.0));
        ink += txt(fragCoord, vec2(x, y0 - lh),     T_PLR, N_PLR, typed(tb2, 0.9));
        ink += txt(fragCoord, vec2(x, y0 - 2.*lh),  T_SOV, N_SOV, typed(tb2, 1.8));
        ink += txt(fragCoord, vec2(x, y0 - 3.*lh),  T_CQ,  N_CQ,  typed(tb2, 2.7));
    }

    // --- left: segmented loading bar that fills, holds, and resets
    {
        vec2 o = vec2(30.0, 470.0);
        float prog = clamp(mod(t, 14.0) / 10.0, 0.0, 1.0);
        float segW = 14.0, gap = 5.0;
        float i = floor((p.x - o.x) / (segW + gap));
        float inSeg = step(0.0, i) * step(i, 19.0) * step(mod(p.x - o.x, segW + gap), segW);
        float onB = step(i + 1.0, floor(prog * 20.0 + 0.001));
        float box = step(abs(p.y - o.y), 9.0);
        ink += inSeg * box * onB;
        dim += inSeg * box * (1.0 - onB) * 0.6;
        ink += num(fragCoord, o + vec2(390.0, -6.0), int(prog * 100.0), 3);
        ink += txt(fragCoord, o + vec2(0.0, 18.0), T_RUN, 7, 99);   // "RUNNING"
        // hatched block under it, stripes crawl slowly
        vec2 hq = p - o - vec2(185.0, -60.0);
        float hb = sdBox(hq, vec2(185.0, 26.0));
        float hatch = step(0.5, fract((hq.x + hq.y + t * 10.0) / 12.0));
        ink += fill(abs(hb) - 1.2);
        ink += hatch * fill(hb + 6.0) * 0.9;
    }

    // --- bottom-left crosshair + coordinate
    {
        vec2 c = vec2(300.0, 290.0);
        ink += fill(plus(p - c, 9.0, 0.9));
        int a = 35 + int(floor(t * 0.5)) % 10;
        int b = 500 + int(h11(floor(t * 2.0)) * 99.0);
        ink += num(fragCoord, c + vec2(14.0, -6.0), a, 2);
        ink += punct(fragCoord, c + vec2(14.0 + 12.0 * FP / S, -6.0), 2);
        ink += num(fragCoord, c + vec2(14.0 + 18.0 * FP / S, -6.0), b, 3);
    }

    // --- bottom-right cluster: four squares, AB / YZ, readouts
    {
        vec2 c = vec2(W * 0.5 + 345.0, 290.0);
        for (int i = 0; i < 4; i++) {
            vec2 o = c + vec2(float(i % 2) * 160.0 - 80.0, float(i / 2) * -105.0 + 50.0);
            float bl = step(0.25, h11(float(i) + floor(t * 2.0)));
            ink += bl * fill(sdBox(p - o, vec2(4.5)));
        }
        ink += txt(fragCoord, c + vec2(-10.0, 45.0), T_AB, N_AB, 99);
        ink += txt(fragCoord, c + vec2(-10.0, -60.0), T_YZ, N_YZ, 99);
        for (int i = 0; i < 2; i++) {
            vec2 o = c + vec2(-45.0, 10.0 - float(i) * 18.0);
            int v = int(h11(floor(t * 4.0) + float(i) * 9.0) * 99999.0);
            ink += num(fragCoord, o, v / 10, 4);
            ink += punct(fragCoord, o + vec2(24.0 * FP / S, 0.0), 0);
            ink += num(fragCoord, o + vec2(30.0 * FP / S, 0.0), v % 10, 1);
            ink += punct(fragCoord, o + vec2(42.0 * FP / S, 0.0), 1);
        }
        // log block next to it
        float x = c.x + 150.0, y0 = 340.0;
        float tb3 = mod(t + 4.0, 16.0);
        ink += txt(fragCoord, vec2(x, y0),         T_CKP,  N_CKP,  typed(tb3, 0.0));
        ink += txt(fragCoord, vec2(x, y0 - lh),    T_CSAT, N_CSAT, typed(tb3, 0.8));
        ink += txt(fragCoord, vec2(x, y0 - 2.*lh), T_NLD,  N_NLD,  typed(tb3, 1.4));
        ink += txt(fragCoord, vec2(x, y0 - 3.*lh), T_NIO,  N_NIO,  typed(tb3, 2.0));
        ink += txt(fragCoord, vec2(x, y0 - 4.*lh), T_MEMB, N_MEMB, typed(tb3, 2.8));
    }

    // --- bottom ticker
    {
        float w = float(N_TICK * 6) * FP;            // screen px
        vec2 q = floor(vec2(mod(fragCoord.x + t * 40.0, w), fragCoord.y - floor(18.0 * S)) / FP);
        ink += textLine(q, T_TICK, N_TICK);
    }

    ink = clamp(ink, 0.0, 1.0);
    col = mix(col, GREY, clamp(dim, 0.0, 1.0));
    col = mix(col, lime, ink);

    col += (h21(fragCoord + fract(t) * 100.0) - 0.5) * GRAIN;
    fragColor = vec4(col, 1.0);
}
