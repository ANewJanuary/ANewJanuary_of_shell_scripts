// fps: 30
// CONDUIT: graphic take on the "transistors" render. Top-down view of thick
// dark cables snaking down the screen with printed labels and barcodes, thin
// green signal wires with pulses running along them, and a central spine of
// electric-blue channels carrying a train of modules. Everything scrolls slowly.
// Text lives in the @text block; run tools/gentext.py after editing it.

// ---- tweakables --------------------------------------------------------
const float SCROLL = 18.0;     // scroll speed, world units / s (1 unit ~ 1 design px on the floor)
const float CAM_H  = 1500.0;   // camera height above the floor
const float TILT   = 0.42;     // camera tilt away from straight down (radians)
const float FOCAL  = 1250.0;   // focal length in design px (smaller = wider, stronger perspective)
const vec2  LIGHT  = vec2(0.45, -0.6);  // shadow offset per unit of height
const float PULSE  = 140.0;    // speed of the signal pulses on the wires
const float GRAIN  = 0.03;

const vec3 BG     = vec3(0.040, 0.043, 0.046);
const vec3 CABLE  = vec3(0.085, 0.090, 0.095);
const vec3 CABLE_HI = vec3(0.230, 0.240, 0.250);
const vec3 PRINT  = vec3(0.780, 0.800, 0.780);
const vec3 WIRE   = vec3(0.180, 0.750, 0.220);
const vec3 SIGNAL = vec3(0.830, 1.000, 0.000);
const vec3 BLUE   = vec3(0.080, 0.180, 1.000);
const vec3 MARK   = vec3(0.600, 0.620, 0.610);
const vec3 MASK   = vec3(0.040, 0.043, 0.046);   // board colour (same as BG)
const vec3 GOLD   = vec3(0.420, 0.330, 0.140);   // pads / vias
const vec3 SILK   = vec3(0.560, 0.590, 0.560);   // silkscreen
const float PW    = 150.0;     // spine platform half width
const float PH    = 75.0;      // spine platform height
const float PL    = 480.0;     // platform segment pitch
const float PG    = 70.0;      // gap between platform segments
const float MH    = 48.0;      // module height above the platform

// @text
// DC      DATA CONDUIT | CYCLING
// AUX     AUXILIARY SMARTWIRE INSULATION
// SUB     SUB001
// MAIN    MAIN001
// SLOT    SLOT A
// LINK    LINK
// FIB     FIBRE BUNDLE 07-C
