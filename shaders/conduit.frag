// p in font pixels (glyph = 5x7, advance 6), origin bottom-left of the line.
// One glyph, q in font pixels inside its 6x7 cell.
float glyphPix(vec2 q, int g) {
    int col = int(q.x), row = 6 - int(q.y);
    if (col < 0 || col > 4 || row < 0 || row > 6) return 0.0;
    return float((FONT[g * 5 + col] >> uint(row)) & 1u);
}
float textLine(vec2 p, int start, int len) {
    if (p.y < 0.0 || p.y >= 7.0 || p.x < 0.0 || p.x >= float(len) * 6.0) return 0.0;
    int ci = int(p.x) / 6;
    return glyphPix(vec2(p.x - float(ci * 6), p.y), TXT[start + ci]);
}
// @endgen

float h11(float n) { return fract(sin(n * 127.1) * 43758.5453); }
float h21(vec2 p)  { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float sdBox(vec2 p, vec2 b) { vec2 d = abs(p) - b; return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0); }
float sdRound(vec2 p, vec2 b, float r) { return sdBox(p, b - r) - r; }

float PX;   // one screen pixel in design units
float fill(float d) { return clamp(0.5 - d / PX, 0.0, 1.0); }

// text line at glyph coords g (font px)
float tl(vec2 g, int start, int len) { return textLine(floor(g), start, len); }
// vertical text reading top-to-bottom, letters' tops toward +x
float vtext(vec2 p, vec2 o, float fs, int start, int len) {
    return tl(vec2(o.y - p.y, p.x - o.x) / fs, start, len);
}
float htext(vec2 p, vec2 o, float fs, int start, int len) { return tl((p - o) / fs, start, len); }
// single digit / letter glyph
float glyph(vec2 p, vec2 o, float fs, int g) { return glyphPix(floor((p - o) / fs), g); }

// ---- cables ------------------------------------------------------------
// centre line x(y) of cable i and its slope
float cableX(int i, float y, out float slope) {
    float fi = float(i);
    float side = i < 5 ? -1.0 : 1.0;
    float j = mod(fi, 5.0);
    float base = side * (230.0 + j * 120.0 + h11(fi) * 60.0);
    float A = 50.0 + 110.0 * h11(fi + 3.0), f = 0.0022 + 0.0018 * h11(fi + 5.0), ph = h11(fi + 7.0) * 6.28;
    float B = 30.0 * h11(fi + 9.0), f2 = f * 0.41;
    slope = A * f * cos(y * f + ph) + B * f2 * cos(y * f2 + ph);
    return base + A * sin(y * f + ph) + B * sin(y * f2 + ph);
}
float cableW(int i) { return 18.0 + 26.0 * h11(float(i) + 11.0); }
// cables are stacked: draw order k (0 = lowest) -> cable index and height
int   cableAt(int k) { return (k * 3) % 10; }
float cableH(int k)  { return 150.0 + float(k) * 28.0; }  // well above the spine platform, big steps between cables

// signal wires (all above the cables)
float wireX(int i, float y, out float slope) {
    float fi = float(i);
    float side = i < 7 ? -1.0 : 1.0;
    float base = side * (170.0 + mod(fi, 7.0) * 105.0 + h11(fi + 20.0) * 70.0);
    float A = 60.0 + 150.0 * h11(fi + 21.0), f = 0.0015 + 0.002 * h11(fi + 22.0), ph = h11(fi + 23.0) * 6.28;
    float B = 40.0 * h11(fi + 25.0), f2 = f * 0.37;
    slope = A * f * cos(y * f + ph) + B * f2 * cos(y * f2 + ph);
    return base + A * sin(y * f + ph) + B * sin(y * f2 + ph);
}
float wireH(int i) { return 450.0 + float(i) * 6.0; }
bool  wireOn(int i, float y) { return h21(vec2(float(i), floor(y / 900.0))) > 0.3; }

// ---- camera ------------------------------------------------------------
vec3 RO, RD;
// world xy where the view ray meets the plane at height h; sets PX for AA
vec2 onPlane(float h) {
    float t = (h - RO.z) / RD.z;
    vec2 w = RO.xy + RD.xy * t;
    PX = max(fwidth(w.x), fwidth(w.y)) * 0.9 + 1e-4;
    return w;
}

// how much the stuff above height h darkens point w (shadows of cables + wires)
float shadowAt(vec2 w, float h) {
    float sh = 1.0;
    for (int k = 0; k < 10; k++) {
        float hc = cableH(k);
        if (hc <= h + 1.0) continue;
        int i = cableAt(k);
        float dh = hc - h;
        vec2 q = w - LIGHT * dh;
        float sl; float cx = cableX(i, q.y, sl);
        float d = abs(q.x - cx) * inversesqrt(1.0 + sl * sl);
        float soft = 4.0 + dh * 0.12;
        sh *= 1.0 - 0.6 * smoothstep(cableW(i) + soft, cableW(i) - soft, d);
    }
    for (int i = 0; i < 14; i++) {
        float dh = wireH(i) - h;
        vec2 q = w - LIGHT * dh;
        if (!wireOn(i, q.y)) continue;
        float sl; float wx = wireX(i, q.y, sl);
        float d = abs(q.x - wx) * inversesqrt(1.0 + sl * sl);
        sh *= 1.0 - 0.35 * smoothstep(3.0 + dh * 0.05, 0.0, d);
    }
    return sh;
}

// ---- motherboard -------------------------------------------------------
const float CELL = 115.0;
const float HCOMP = 60.0;      // tallest part on the board
struct Comp { int type; vec2 c; vec2 hs; float h; float seed; };
// type: 0 none, 1 chip, 2 capacitor (radius hs.x), 3 heatsink, 4 memory slot, 5 small chip
Comp compAt(vec2 cell) {
    Comp k; k.type = 0; k.c = vec2(0); k.hs = vec2(0); k.h = 0.0;
    vec2 cc = (cell + 0.5) * CELL;
    k.seed = h21(cell + 17.0);
    if (abs(cc.x) < 190.0) return k;                       // keep the spine clear
    float r = h21(cell);
    vec2 jit = (vec2(h21(cell + 1.0), h21(cell + 2.0)) - 0.5) * 24.0;
    if (r < 0.08)      { k.type = 1; k.hs = vec2(24.0 + 16.0 * h21(cell + 3.0), 20.0 + 14.0 * h21(cell + 4.0)); k.h = 10.0; }
    else if (r < 0.14) { k.type = 2; k.hs = vec2(12.0 + 9.0 * h21(cell + 3.0)); k.h = 28.0 + 26.0 * h21(cell + 4.0); }
    else if (r < 0.165) { k.type = 3; k.hs = vec2(38.0); k.h = 40.0; }
    else if (r < 0.2)  { k.type = 4; k.hs = h21(cell + 5.0) > 0.5 ? vec2(50.0, 10.0) : vec2(10.0, 50.0); k.h = 20.0; }
    else if (r < 0.27) { k.type = 5; k.hs = h21(cell + 6.0) > 0.5 ? vec2(9.0, 4.5) : vec2(4.5, 9.0); k.h = 4.0; }   // SMD resistor
    k.c = cc + jit;
    return k;
}
// ray vs part: returns t (1e9 if missed) and the surface normal
float hitComp(Comp k, vec3 ro, vec3 rd, out vec3 n) {
    n = vec3(0, 0, 1);
    if (k.type == 0) return 1e9;
    if (k.type == 2) {                                     // capacitor: cylinder
        vec2 oc = ro.xy - k.c;
        float rr = k.hs.x * k.hs.x;
        float tt = (k.h - ro.z) / rd.z;
        vec2 pt = oc + rd.xy * tt;
        if (dot(pt, pt) <= rr) return tt;                  // top disc
        float a = dot(rd.xy, rd.xy), b = dot(oc, rd.xy), c = dot(oc, oc) - rr;
        float disc = b * b - a * c;
        if (disc < 0.0) return 1e9;
        float t1 = (-b - sqrt(disc)) / a;
        float z = ro.z + rd.z * t1;
        if (z < 0.0 || z > k.h) return 1e9;
        n = vec3((oc + rd.xy * t1) / k.hs.x, 0.0);
        return t1;
    }
    vec3 bmin = vec3(k.c - k.hs, 0.0), bmax = vec3(k.c + k.hs, k.h);
    vec3 t1 = (bmin - ro) / rd, t2 = (bmax - ro) / rd;
    vec3 tn = min(t1, t2), tf = max(t1, t2);
    float tN = max(max(tn.x, tn.y), tn.z), tF = min(min(tf.x, tf.y), tf.z);
    if (tN > tF || tF < 0.0) return 1e9;
    n = tN == tn.z ? vec3(0, 0, 1) : (tN == tn.x ? vec3(-sign(rd.x), 0, 0) : vec3(0, -sign(rd.y), 0));
    return tN;
}
int chipLabel(float s, out int n) {
    int i = int(s * 4.0);
    n = i == 0 ? N_U1 : i == 1 ? N_U2 : i == 2 ? N_U3 : N_U4;
    return i == 0 ? T_U1 : i == 1 ? T_U2 : i == 2 ? T_U3 : T_U4;
}
int silkLabel(float s, out int n) {
    int i = int(s * 4.0);
    n = i == 0 ? N_S1 : i == 1 ? N_S2 : i == 2 ? N_S3 : N_S4;
    return i == 0 ? T_S1 : i == 1 ? T_S2 : i == 2 ? T_S3 : T_S4;
}
vec3 shadeComp(Comp k, vec3 hp, vec3 n) {
    vec3 L3 = normalize(vec3(-0.45, 0.6, 1.0));
    float lam = max(dot(n, L3), 0.0);
    float spec = pow(max(dot(n, normalize(L3 + vec3(0, -0.3, 1))), 0.0), 30.0);
    vec2 q = hp.xy - k.c;
    bool top = n.z > 0.5;
    vec3 col;
    if (k.type == 5) {
        bool lx = k.hs.x > k.hs.y;
        float a = lx ? abs(q.x) : abs(q.y), L = lx ? k.hs.x : k.hs.y;
        col = (a > L - 3.0 ? GOLD : vec3(0.05)) * (0.4 + 1.0 * lam) + vec3(0.2) * spec;
    } else if (k.type == 1) {
        vec3 base = vec3(0.090, 0.094, 0.100);
        col = base * (0.35 + 1.0 * lam) + vec3(0.12) * spec * 0.6;
        if (top) {
            int nn; int st = chipLabel(k.seed, nn);
            float fs = k.type == 1 ? 1.7 : 1.1;
            col = mix(col, MARK * 0.8, htext(q, vec2(-k.hs.x + 5.0, -3.5 * fs), fs, st, nn));
            col = mix(col, MARK * 0.6, fill(length(q - vec2(-k.hs.x + 5.0, k.hs.y - 5.0)) - 2.2));
            col *= 0.85 + 0.15 * smoothstep(0.0, 3.0, min(k.hs.x - abs(q.x), k.hs.y - abs(q.y)));
        }
    } else if (k.type == 2) {
        if (top) {
            col = vec3(0.42, 0.44, 0.46) * (0.55 + 0.6 * lam);
            float sc = min(abs(q.x + q.y), abs(q.x - q.y)) * 0.707;    // scored X vent
            col *= 0.6 + 0.4 * smoothstep(0.6, 1.6, sc);
            col *= 0.7 + 0.3 * smoothstep(k.hs.x, k.hs.x - 3.0, length(q));
        } else {
            float a = atan(n.y, n.x);
            vec3 sleeve = mix(vec3(0.020, 0.040, 0.120), vec3(0.030, 0.090, 0.050), step(0.5, k.seed));
            float stripe = step(abs(mod(a - k.seed * 6.0, 6.2832) - 0.5), 0.4);
            col = mix(sleeve * 2.0, vec3(0.45), stripe) * (0.3 + 1.0 * lam) + vec3(0.35) * spec;
            col *= 0.8 + 0.2 * step(2.0, abs(hp.z - k.h + 4.0));       // crimp ring near the top
        }
    } else if (k.type == 3) {
        vec3 base = vec3(0.110, 0.118, 0.130);
        bool alongX = k.seed > 0.5;
        float fin = step(0.45, fract((alongX ? q.y : q.x) / 6.0));
        if (top) col = mix(base * 0.35, base * 2.2, fin) * (0.5 + 0.7 * lam) + vec3(0.15) * spec * fin;
        else col = mix(base * 0.4, base * 1.3, alongX == (abs(n.x) > 0.5) ? fin : 1.0) * (0.4 + 0.8 * lam);
    } else {
        vec3 base = vec3(0.060, 0.080, 0.140);
        col = base * (0.35 + 1.0 * lam);
        if (top) {
            bool lx = k.hs.x > k.hs.y;
            float acr = lx ? q.y : q.x, alg = lx ? q.x : q.y, L = lx ? k.hs.x : k.hs.y;
            col = mix(col, vec3(0.01), step(abs(acr), 2.2) * step(abs(alg), L - 7.0));   // slot groove
            col = mix(col, vec3(0.30, 0.32, 0.30), step(L - 6.0, abs(alg)));          // latches
        }
    }
    // lit top edge, dark bottom contact line: makes the volume read
    if (top && k.type != 2) col += vec3(0.16) * fill(min(k.hs.x - abs(q.x), k.hs.y - abs(q.y)) - 1.0);
    if (top && k.type == 2) col += vec3(0.18) * fill(k.hs.x - length(q) - 1.0);
    if (!top) col *= 0.55 + 0.45 * smoothstep(0.0, 4.0, hp.z);
    return col * shadowAt(hp.xy, hp.z);
}
// one PCB trace from (x0,ya) to (x1,yb): straight, a 45 degree jog, straight
float traceSeg(vec2 p, float x0, float x1, float ya, float yb) {
    float dy = yb - ya, xm = 0.5 * (x0 + x1), hj = abs(dy) * 0.5;
    vec2 A = vec2(x0, ya), B = vec2(xm - hj, ya), C = vec2(xm + hj, yb), D = vec2(x1, yb);
    vec2 pa = p - A, pb = p - B, pc = p - C;
    vec2 ab = B - A, bc = C - B, cd = D - C;
    float d1 = length(pa - ab * clamp(dot(pa, ab) / max(dot(ab, ab), 1e-3), 0.0, 1.0));
    float d2 = length(pb - bc * clamp(dot(pb, bc) / max(dot(bc, bc), 1e-3), 0.0, 1.0));
    float d3 = length(pc - cd * clamp(dot(pc, cd) / max(dot(cd, cd), 1e-3), 0.0, 1.0));
    return min(min(d1, d2), d3);
}
// a family of routed traces. q: coords with traces running along +x.
// returns trace mask, writes pad (via) mask and the along-trace coordinate.
float traces(vec2 q, float seed, float rowH, float cellW, float density, out float via, out float on) {
    float row = floor(q.y / rowH), ly = q.y - row * rowH;
    float ci = floor(q.x / cellW), x0 = ci * cellW, x1 = x0 + cellW;
    float tr = 0.0; via = 0.0; on = 0.0;
    for (int l = 0; l < 2; l++) {
        float fl = float(l);
        float base = rowH * (0.25 + 0.5 * fl);
        vec3 key = vec3(row, fl, seed);
        float ja = (floor(h21(vec2(ci, key.x * 7.0 + fl + seed)) * 3.0) - 1.0) * rowH * 0.18;
        float jb = (floor(h21(vec2(ci + 1.0, key.x * 7.0 + fl + seed)) * 3.0) - 1.0) * rowH * 0.18;
        bool here = h21(vec2(ci, row * 3.0 + fl + seed * 5.0)) > 1.0 - density;
        if (!here) continue;
        float d = traceSeg(vec2(q.x, ly), x0, x1, base + ja, base + jb);
        float m = fill(d - 1.5);
        if (m > tr) { tr = m; on = row * 2.0 + fl; }
        bool prev = h21(vec2(ci - 1.0, row * 3.0 + fl + seed * 5.0)) > 1.0 - density;
        bool next = h21(vec2(ci + 1.0, row * 3.0 + fl + seed * 5.0)) > 1.0 - density;
        if (!prev) via = max(via, fill(length(vec2(q.x - x0, ly - base - ja)) - 4.0));
        if (!next) via = max(via, fill(length(vec2(q.x - x1, ly - base - jb)) - 4.0));
    }
    return tr;
}
// the bare board: solder mask, routed copper traces, pads, vias, silkscreen
vec3 boardCol(vec2 w, float t) {
    vec3 col = MASK * (0.9 + 0.2 * h21(floor(w / 300.0)));
    float via1, via2, id1, id2;
    float th = traces(w, 1.0, 44.0, 90.0, 0.32, via1, id1);
    float tv = traces(w.yx, 2.0, 60.0, 120.0, 0.15, via2, id2);
    vec3 tc = MASK * 1.9;
    col = mix(col, tc, max(th, tv));
    float via = max(via1, via2);
    col = mix(col, GOLD * 0.9, via);
    col = mix(col, vec3(0.0), via * fill(length(fract(w / 1.0) * 0.0) - 0.0) * 0.0);
    // data pulses along some horizontal traces
    float k = h11(id1 * 1.37);
    float pz = mod(w.x * (k > 0.5 ? 1.0 : -1.0) + t * 130.0 + k * 900.0, 800.0);
    col += SIGNAL * th * smoothstep(50.0, 0.0, pz) * step(0.65, h11(id1 * 3.1)) * 0.9;
    // mounting holes
    vec2 mg = w / 420.0, mc = floor(mg), mf = (fract(mg) - 0.5) * 420.0;
    if (h21(mc + 40.0) > 0.85 && abs(mc.x * 420.0 + 210.0) > 300.0) {
        float r = length(mf);
        col = mix(col, GOLD, fill(abs(r - 12.0) - 4.0));
        col = mix(col, vec3(0.005), fill(r - 8.0));
    }
    // parts in this cell: pads + silkscreen
    vec2 cell = floor(w / CELL);
    Comp c = compAt(cell);
    if (c.type != 0) {
        vec2 q = w - c.c;
        if (c.type == 1) {
            float inPin = step(c.hs.x, abs(q.x)) * step(abs(q.x), c.hs.x + 6.0) * step(abs(q.y), c.hs.y - 3.0);
            col = mix(col, GOLD * 1.2, inPin * step(0.5, fract(q.y / 4.0)));
        }
        if (c.type == 5) col = mix(col, GOLD, step(sdBox(q, c.hs + 1.5), 0.0));
        vec2 hs = c.type == 2 ? vec2(c.hs.x) : c.hs;
        if (c.type != 5) {
            float outline = c.type == 2 ? fill(abs(length(q) - hs.x - 6.0) - 0.7) : fill(abs(sdBox(q, hs + 9.0)) - 0.7);
            col = mix(col, SILK, outline * 0.7);
        }
        int nn; int st = silkLabel(c.seed * 0.97 + 0.01, nn);
        col = mix(col, SILK, htext(q, vec2(-hs.x - 6.0, hs.y + 10.0), 1.4, st, nn) * 0.75);
    }
    // shadows of parts
    for (int j = 0; j < 2; j++) {
        vec2 sw = w - LIGHT * (j == 0 ? 12.0 : 40.0);
        Comp ks = compAt(floor(sw / CELL));
        if (ks.type == 0) continue;
        vec2 q = w - LIGHT * ks.h - ks.c;
        float d = ks.type == 2 ? length(q) - ks.hs.x : sdBox(q, ks.hs);
        float inFoot = ks.type == 2 ? step(length(w - ks.c), ks.hs.x) : step(sdBox(w - ks.c, ks.hs), 0.0);
        col *= 1.0 - 0.6 * smoothstep(6.0, -4.0, d) * (1.0 - inFoot);
    }
    // shadow of the raised spine platform (its segments)
    {
        vec2 q = w - LIGHT * PH;
        float ly = mod(q.y, PL);
        float d = max(abs(q.x) - PW, max(PG - ly, ly - PL));
        col *= 1.0 - 0.7 * smoothstep(10.0, -10.0, d);
    }
    return col;
}

// the spine deck: dark track, blue channels, clips, arrows, labels
vec3 spineCol(vec2 w, vec3 col) {
    float ax = abs(w.x), y = w.y;
    col = vec3(0.060, 0.063, 0.068);
    float ch = sdBox(vec2(ax - 112.0, 0.0), vec2(11.0, 1e4));
    vec3 bl = BLUE * (0.65 + 0.35 * smoothstep(11.0, 0.0, abs(ax - 112.0)));
    col = mix(col, bl, fill(ch));
    float tr = sdBox(vec2(ax, 0.0), vec2(96.0, 1e4));
    col = mix(col, vec3(0.050, 0.053, 0.058), fill(tr));
    float cy = mod(y, 120.0) - 60.0;
    float clip = sdRound(vec2(ax - 112.0, cy), vec2(15.0, 9.0), 2.0);
    col = mix(col, vec3(0.02), fill(clip));
    col = mix(col, MARK, fill(min(sdBox(vec2(ax - 112.0, cy), vec2(4.0, 0.8)), sdBox(vec2(ax - 112.0, cy), vec2(0.8, 4.0)))) * 0.8);
    float ay = mod(y + 60.0, 240.0) - 120.0;
    vec2 aq = vec2(ax - 80.0, ay);
    float tri = max(abs(aq.x) * 0.9 + aq.y * 0.6 - 5.0, -aq.y - 4.0);
    col = mix(col, PRINT * 0.9, fill(tri));
    float ly = mod(y, 360.0);
    col = mix(col, PRINT * 0.8, vtext(vec2(w.x, ly), vec2(w.x > 0.0 ? 130.0 : -146.0, 300.0), 2.0, T_LINK, N_LINK));
    col = mix(col, WIRE, fill(abs(w.x) - 1.6));
    float lv = mod(y + 260.0, 520.0);
    col = mix(col, PRINT, vtext(vec2(w.x, lv), vec2(-46.0, 470.0), 3.0, T_MAIN, N_MAIN));
    col = mix(col, PRINT * 0.85, vtext(vec2(w.x, lv), vec2(28.0, 430.0), 2.0, T_DC, 14));
    // deck edge trim
    col = mix(col, vec3(0.16), fill(abs(ax - PW + 4.0) - 1.2));
    return col;
}

// ray vs axis-aligned box
float hitBox(vec3 bmin, vec3 bmax, out vec3 n) {
    vec3 t1 = (bmin - RO) / RD, t2 = (bmax - RO) / RD;
    vec3 tn = min(t1, t2), tf = max(t1, t2);
    float tN = max(max(tn.x, tn.y), tn.z), tF = min(min(tf.x, tf.y), tf.z);
    n = vec3(0, 0, 1);
    if (tN > tF || tF < 0.0) return 1e9;
    n = tN == tn.z ? vec3(0, 0, 1) : (tN == tn.x ? vec3(-sign(RD.x), 0, 0) : vec3(0, -sign(RD.y), 0));
    return tN;
}

// ---- main --------------------------------------------------------------
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    float t = iTime;
    float S = iResolution.y / 1080.0;
    vec2 p = (fragCoord - 0.5 * iResolution.xy) / S;   // design coords, centred
    float W = iResolution.x / S;

    // tilted pinhole camera, gliding along +y and drifting sideways a little
    vec3 fw = normalize(vec3(0.0, sin(TILT), -cos(TILT)));
    vec3 rt = vec3(1.0, 0.0, 0.0);
    vec3 up = cross(rt, fw);
    RO = vec3(sin(t * 0.035) * 140.0, t * SCROLL - CAM_H * tan(TILT), CAM_H);
    RD = normalize(fw * FOCAL + rt * p.x + up * p.y);
    vec3 L3 = normalize(vec3(-0.45, 0.6, 1.0));

    vec2 wt = onPlane(HCOMP);
    vec2 wp = onPlane(PH + MH);
    vec2 w = onPlane(0.0);
    vec3 col = boardCol(w, t) * shadowAt(w, 0.0);

    // ---- nearest solid: board parts, platform segments, conduit rods, modules
    float best = -RO.z / RD.z;
    int what = 0; vec3 bn = vec3(0, 0, 1); Comp bk; bk.type = 0; float bid = 0.0;
    {
        vec2 ca = floor(w / CELL), cb = floor(wt / CELL);
        for (int j = 0; j < 4; j++) {
            vec2 cc = j == 0 ? ca : j == 1 ? cb : j == 2 ? vec2(ca.x, cb.y) : vec2(cb.x, ca.y);
            Comp k = compAt(cc);
            vec3 n; float th = hitComp(k, RO, RD, n);
            if (th < best) { best = th; bn = n; bk = k; what = 1; }
        }
        // platform segments around where the ray passes
        for (int j = 0; j < 2; j++) {
            float seg = floor((j == 0 ? w.y : wp.y) / PL);
            vec3 n; float th = hitBox(vec3(-PW, seg * PL + PG, 0.0), vec3(PW, seg * PL + PL, PH), n);
            if (th < best) { best = th; bn = n; what = 2; bid = seg; }
        }
        // blue conduit rods bridging the gaps between segments
        for (int s2 = 0; s2 < 2; s2++) {
            float cxr = s2 == 0 ? -112.0 : 112.0, czr = PH - 12.0, rr = 10.0;
            vec2 o = RO.xz - vec2(cxr, czr), d = RD.xz;
            float a = dot(d, d), b = dot(o, d), c = dot(o, o) - rr * rr, disc = b * b - a * c;
            if (disc > 0.0) {
                float th = (-b - sqrt(disc)) / a;
                if (th > 0.0 && th < best) { best = th; bn = vec3((o + d * th) / rr, 0.0).xzy; bn = vec3(bn.x, 0.0, bn.z); what = 3; }
            }
        }
        // modules standing on the platform
        for (int j = 0; j < 2; j++) {
            float my = floor(((j == 0 ? onPlane(PH).y : wp.y)) / 520.0);
            vec3 n; float th = hitBox(vec3(-78.0, my * 520.0 + 190.0, PH), vec3(78.0, my * 520.0 + 330.0, PH + MH), n);
            if (th < best) { best = th; bn = n; what = 4; bid = my; }
        }
    }
    if (what > 0) {
        vec3 hp = RO + RD * best;
        PX = max(fwidth(hp.x), fwidth(hp.y)) * 0.9 + 1e-4;
        float lam = max(dot(bn, L3), 0.0);
        if (what == 1) col = shadeComp(bk, hp, bn);
        else if (what == 2) {
            if (bn.z > 0.5) {
                col = spineCol(hp.xy, col) * (0.8 + 0.3 * lam);
                col = mix(col, vec3(0.22), fill(min(PW - abs(hp.x), hp.y - (bid * PL + PG)) - 1.5));   // lit edges
            } else if (abs(bn.y) > 0.5) {
                // front face: ribbed metal, a row of lights, label
                vec2 f = vec2(hp.x, hp.z);
                col = vec3(0.050, 0.053, 0.058) * (0.5 + 0.8 * lam);
                col *= 0.8 + 0.2 * step(0.5, fract(f.y / 6.0));
                float lr = step(abs(f.y - PH * 0.62), 2.2) * step(0.5, fract(f.x / 14.0)) * step(abs(f.x), PW - 20.0);
                float on = step(0.35, h21(vec2(floor(f.x / 14.0), bid + floor(t * 2.0))));
                col += mix(BLUE * 1.2, SIGNAL, step(0.85, h21(vec2(floor(f.x / 14.0), bid)))) * lr * on * 0.9;
                col = mix(col, PRINT * 0.7, htext(f, vec2(-PW + 14.0, 14.0), 2.0, T_MAIN, N_MAIN));
                col = mix(col, vec3(0.2), fill(PH - f.y - 1.5));
            } else {
                // side wall: panel seams and vents
                vec2 f = vec2(hp.y, hp.z);
                col = vec3(0.045, 0.048, 0.052) * (0.45 + 0.9 * lam);
                col *= 0.75 + 0.25 * step(3.0, mod(f.x, 80.0));
                col = mix(col, vec3(0.015), step(abs(f.y - PH * 0.45), 8.0) * step(0.5, fract(f.x / 8.0)) * step(mod(f.x, 80.0), 50.0) * 0.8);
                col = mix(col, vec3(0.2), fill(PH - f.y - 1.5));
            }
            col *= shadowAt(hp.xy, hp.z);
        } else if (what == 3) {
            float spec = pow(max(dot(bn, normalize(L3 + vec3(0, -0.3, 1))), 0.0), 30.0);
            col = BLUE * (0.25 + 0.9 * lam) + vec3(0.4) * spec;
            col *= shadowAt(hp.xy, hp.z);
        } else {
            vec2 mq = vec2(hp.x, hp.y - bid * 520.0 - 260.0);
            if (bn.z > 0.5) {
                vec3 mc = vec3(0.085, 0.088, 0.092) * (0.8 + 0.3 * lam);
                float box = sdRound(mq, vec2(78.0, 70.0), 6.0);
                float sw = sdRound(mq - vec2(0.0, 22.0), vec2(26.0, 22.0), 3.0);
                mc = mix(mc, vec3(0.22), fill(abs(box) - 1.5));
                mc = mix(mc, PRINT, fill(abs(sw) - 1.2));
                mc = mix(mc, PRINT * 0.8, htext(mq, vec2(-20.0, 28.0), 1.4, T_SLOT, N_SLOT));
                mc = mix(mc, PRINT, htext(mq, vec2(-24.0, -52.0), 2.0, T_SLOT, N_SLOT));
                float on = step(0.4, h11(bid + floor(t * 1.5)));
                mc = mix(mc, mix(vec3(0.1), SIGNAL, on), fill(length(mq - vec2(55.0, 50.0)) - 3.5));
                col = mc;
            } else {
                vec2 f = abs(bn.y) > 0.5 ? vec2(hp.x, hp.z - PH) : vec2(hp.y, hp.z - PH);
                col = vec3(0.060, 0.063, 0.068) * (0.45 + 0.9 * lam);
                col = mix(col, vec3(0.012), step(abs(f.y - MH * 0.5), 10.0) * step(0.5, fract(f.x / 6.0)) * step(abs(abs(bn.y) > 0.5 ? f.x : mq.y), 50.0));
                col = mix(col, vec3(0.2), fill(MH - f.y - 1.2));
            }
            col *= shadowAt(hp.xy, hp.z);
        }
        PX = max(fwidth(w.x), fwidth(w.y)) * 0.9 + 1e-4;
    }

    // ---- cables, lowest first
    for (int k = 0; k < 10; k++) {
        int i = cableAt(k);
        float hc = cableH(k);
        float w0 = cableW(i);
        // the tube's top surface is at hc; its silhouette is evaluated at hc - r/2
        vec2 c = onPlane(hc);
        float sl; float cx = cableX(i, c.y, sl);
        float cs = inversesqrt(1.0 + sl * sl);
        float u = (c.x - cx) * cs;
        float inC = fill(abs(u) - w0);
        if (inC <= 0.0) continue;
        float r = clamp(u / w0, -1.0, 1.0);
        // cylinder normal across the tube (x across, z up)
        vec2 tan2 = normalize(vec2(1.0, sl)) ;
        vec3 n = normalize(vec3(r * cs, -r * sl * cs, sqrt(max(0.0, 1.0 - r * r))));
        float lam = max(dot(n, L3), 0.0);
        vec3 h3 = normalize(L3 + vec3(0, 0, 1));
        float spec = pow(max(dot(n, h3), 0.0), 40.0);
        vec3 cc = CABLE * (0.35 + 0.9 * lam) + CABLE_HI * spec * 0.9;
        cc += CABLE_HI * smoothstep(0.93, 1.0, abs(r)) * 0.25;         // rim
        float fi = float(i);
        float v = c.y;
        float seg = floor(v / 380.0), lv = mod(v, 380.0);
        float kind = h21(vec2(fi, seg));
        float fs = clamp(w0 * 0.11, 1.6, 3.0);
        vec3 ink = PRINT * (0.45 + 0.6 * lam);
        if (kind < 0.45) {
            int li = int(h21(vec2(seg, fi + 3.0)) * 5.0);
            int st = li == 0 ? T_DC : li == 1 ? T_AUX : li == 2 ? T_FIB : li == 3 ? T_PWR : T_SUB;
            int nn = li == 0 ? N_DC : li == 1 ? N_AUX : li == 2 ? N_FIB : li == 3 ? N_PWR : N_SUB;
            vec2 g = vec2((300.0 - lv) / fs, (u + 3.5 * fs) / fs);
            cc = mix(cc, ink, tl(g, st, nn) * 0.9);
        } else if (kind < 0.75) {
            float bv = lv - 120.0;
            float inB = step(0.0, bv) * step(bv, 70.0) * step(abs(r), 0.7);
            float bars = step(0.45, h11(floor(bv / 3.0) + fi * 7.0 + seg));
            cc = mix(cc, ink, inB * bars);
        } else {
            vec2 q = vec2(u, lv - 200.0);
            float xm = min(sdBox(vec2(q.x + q.y, q.y - q.x) * 0.707, vec2(6.0, 1.3)), sdBox(vec2(q.x - q.y, q.y + q.x) * 0.707, vec2(6.0, 1.3)));
            float sq = sdBox(q - vec2(0.0, -22.0), vec2(5.5));
            cc = mix(cc, ink, fill(min(xm, sq)) * step(12.0, w0));
        }
        float band = step(abs(mod(v + fi * 50.0, 260.0) - 4.0), 2.0);
        cc = mix(cc, CABLE_HI * (0.6 + lam), band * 0.7);
        // shadows from the cables and wires above this one
        cc *= shadowAt(c, hc);
        // contact darkening at the edges (the tube curves away from the light)
        cc *= 0.75 + 0.25 * sqrt(max(0.0, 1.0 - r * r));
        col = mix(col, cc, inC);
    }

    // ---- signal wires, on top
    for (int i = 0; i < 14; i++) {
        float hw = wireH(i);
        vec2 c = onPlane(hw);
        if (!wireOn(i, c.y)) continue;
        float sl; float wx = wireX(i, c.y, sl);
        float d = abs(c.x - wx) * inversesqrt(1.0 + sl * sl);
        float fi = float(i);
        col = mix(col, col * 0.55, fill(d - 3.2) * 0.6);
        col = mix(col, WIRE * (0.8 + 0.4 * smoothstep(1.4, 0.0, d)), fill(d - 1.4));
        float pv = mod(c.y + t * PULSE * (0.6 + 0.8 * h11(fi + 30.0)), 600.0 + 400.0 * h11(fi + 31.0));
        float pulse = smoothstep(60.0, 0.0, pv) * smoothstep(0.0, 6.0, pv);
        col += SIGNAL * pulse * fill(d - 2.2) * 0.9;
        float ny = mod(c.y + h11(fi + 32.0) * 700.0, 700.0) - 350.0;
        col = mix(col, WIRE * 1.2, fill(length(vec2(c.x - wx, ny)) - 5.0));
        int dg = int(h11(fi + 33.0) * 10.0);
        col = mix(col, WIRE, glyph(vec2(c.x - wx, ny), vec2(-12.0, 18.0), 2.6, TXT[T_DIG + dg]));
    }

    // ---- big code numbers, screen-space overlay, top right
    {
        PX = 1.0 / S;
        vec2 o = vec2(W * 0.5 - 360.0, 300.0);
        float fs = 9.0;
        int a = int(h11(floor(t / 9.0)) * 999.0), b = int(h11(floor(t / 9.0) + 5.0) * 99.0);
        for (int k = 0; k < 3; k++) {
            int dg = k == 0 ? a / 100 : k == 1 ? (a / 10) % 10 : a % 10;
            col = mix(col, PRINT * 0.85, glyph(p, o + vec2(float(k) * 6.5 * fs, 0.0), fs, TXT[T_DIG + dg]));
        }
        col = mix(col, PRINT * 0.85, glyph(p, o + vec2(0.0, -10.0 * fs), fs, TXT[T_DIG + b / 10]));
        col = mix(col, PRINT * 0.85, glyph(p, o + vec2(6.5 * fs, -10.0 * fs), fs, TXT[T_DIG + b % 10]));
        int lg = int(h11(floor(t / 9.0) + 9.0) * float(N_LET));
        col = mix(col, PRINT * 0.85, glyph(p, o + vec2(13.0 * fs, -10.0 * fs), fs, TXT[T_LET + lg]));
    }

    // depth haze toward the top (further away) + vignette + grain
    col = mix(col, BG * 0.8, smoothstep(-200.0, 540.0, p.y) * 0.35);
    vec2 vv = fragCoord / iResolution.xy - 0.5;
    col *= 1.0 - dot(vv, vv) * 0.8;
    col += (h21(fragCoord + fract(t) * 91.0) - 0.5) * GRAIN;
    fragColor = vec4(max(col, 0.0), 1.0);
}
