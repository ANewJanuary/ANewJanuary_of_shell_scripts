// fps: 30
// ATTACH: graphic take on the reveal-cinematic still. A slow walk through a
// hall of standing panels: frosted glass with printed "ATTACH HERE" strips,
// crosses and hazard stripes, white printed boards, and teal pixel-mosaic
// screens. The floor is striped and glossy and reflects the screens.
// Text lives in the @text block; run tools/gentext.py after editing it.

// ---- tweakables --------------------------------------------------------
const float SPEED   = 0.45;   // walking speed
const float ROW     = 3.2;    // spacing of panel rows along the hall
const float HALL    = 2.3;    // half width of the walkway
const int   ROWS    = 14;     // rows traced ahead
const float GRAIN   = 0.035;

const vec3 TEAL   = vec3(0.060, 0.780, 0.700);
const vec3 MINT   = vec3(0.550, 1.000, 0.850);
const vec3 DEEP   = vec3(0.004, 0.035, 0.040);
const vec3 PAPER  = vec3(0.760, 0.800, 0.760);
const vec3 INKC   = vec3(0.020, 0.025, 0.025);
const vec3 ORANGE = vec3(1.000, 0.450, 0.080);
const vec3 LIME   = vec3(0.830, 1.000, 0.000);

// @text
// AH      *ATTACH HERE   *ATTACH HERE   *ATTACH HERE
// ENJ     ENJ CONNECT
// WAY     4 WAY CONN
// UNIT    UNIT 07
// LINK    LINK STABLE
// @endtext
// @gen  (generated by tools/gentext.py from the @text block - don't edit by hand)
const uint FONT[110] = uint[](0u,0u,0u,0u,0u,20u,8u,62u,8u,20u,62u,81u,73u,69u,62u,24u,20u,18u,127u,16u,1u,113u,9u,5u,3u,126u,17u,17u,17u,126u,127u,73u,73u,73u,54u,62u,65u,65u,65u,34u,127u,73u,73u,73u,65u,127u,8u,8u,8u,127u,0u,65u,127u,65u,0u,32u,64u,65u,63u,1u,127u,8u,20u,34u,65u,127u,64u,64u,64u,64u,127u,4u,8u,16u,127u,62u,65u,65u,65u,62u,127u,9u,25u,41u,70u,70u,73u,73u,73u,49u,1u,1u,127u,1u,1u,63u,64u,64u,64u,63u,63u,64u,56u,64u,63u,7u,8u,112u,8u,7u);
const int TXT[81] = int[](1,5,18,18,5,7,9,0,9,8,16,8,0,0,0,1,5,18,18,5,7,9,0,9,8,16,8,0,0,0,1,5,18,18,5,7,9,0,9,8,16,8,8,14,11,0,7,15,14,14,8,7,18,3,0,20,5,21,0,7,15,14,14,19,14,10,18,0,2,4,13,10,14,12,0,17,18,5,6,13,8);
#define T_AH 0
#define N_AH 42
#define T_ENJ 42
#define N_ENJ 11
#define T_WAY 53
#define N_WAY 10
#define T_UNIT 63
#define N_UNIT 7
#define T_LINK 70
#define N_LINK 11
// p in font pixels (glyph = 5x7, advance 6), origin bottom-left of the line.
// One glyph, q in font pixels inside its 6x7 cell.
float glyphPix(vec2 q, int g) {
    int col = int(q.x), row = 6 - int(q.y);
    if (col < 0 || col > 4 || row < 0 || row > 6) return 0.0;
    return float((FONT[g * 5 + col] >> uint(row)) & 1u);
}
float textLine(vec2 p, int start, int len) {
    if (p.y < 0.0 || p.y >= 7.0 || p.x < 0.0 || p.x >= float(len) * 6.0) return 0.0;
    int ci = int(p.x) / 6;
    return glyphPix(vec2(p.x - float(ci * 6), p.y), TXT[start + ci]);
}
// @endgen

float h11(float n) { return fract(sin(n * 127.1) * 43758.5453); }
float h21(vec2 p)  { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vnoise(vec2 p) {
    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(h21(i), h21(i + vec2(1, 0)), f.x), mix(h21(i + vec2(0, 1)), h21(i + vec2(1, 1)), f.x), f.y);
}
float sdBox(vec2 p, vec2 b) { vec2 d = abs(p) - b; return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0); }

float T, PXW;
float fillW(float d) { return clamp(0.5 - d / PXW, 0.0, 1.0); }

// ---- panels --------------------------------------------------------------
struct Panel { vec3 c; vec3 tdir; vec3 n; float hw; float h; int kind; float seed; };
// kind: 0 frosted glass with prints, 1 teal screen, 2 white printed board
Panel panelAt(float k, float side) {
    Panel P;
    float s = h21(vec2(k, side * 3.0 + 1.0));
    P.seed = s;
    float th;
    bool across = h21(vec2(k, side + 9.0)) > 0.78;               // some panels stand across the view
    if (across) th = side * (1.0 + 0.3 * h21(vec2(k, side + 4.0)));
    else th = side * (0.12 + 0.25 * h21(vec2(k, side + 4.0)));
    P.tdir = vec3(sin(th), 0.0, cos(th));
    P.n = vec3(cos(th), 0.0, -sin(th));
    P.hw = across ? 0.7 + 0.5 * h21(vec2(k, side + 5.0)) : 1.1 + 0.8 * h21(vec2(k, side + 5.0));
    float x = side * (HALL + (across ? 0.4 : 0.9) + 1.2 * h21(vec2(k, side + 6.0)));
    P.c = vec3(x, 0.0, k * ROW + ROW * 0.5 * h21(vec2(k, side + 7.0)));
    P.h = 4.0 + 3.5 * h21(vec2(k, side + 8.0));
    float kk = h21(vec2(k, side + 10.0));
    P.kind = kk < 0.45 ? 0 : kk < 0.75 ? 1 : 2;
    return P;
}

// pixel-mosaic screen content (u across, v up, in panel units)
vec3 mosaic(vec2 uv, float seed) {
    float cell = 0.07;
    vec2 g = floor(uv / cell);
    float tq = floor(T * 3.0);
    // occasional horizontal glitch shift
    float gl = step(0.93, h21(vec2(floor(uv.y / 0.4), tq + seed * 10.0)));
    g.x += gl * floor((h21(vec2(tq, g.y)) - 0.5) * 8.0);
    vec2 q = g * cell;
    float n = vnoise(q * 1.6 + vec2(seed * 20.0, T * 0.05)) * 0.6 + vnoise(q * 4.0 - T * 0.08) * 0.4;
    // a soft vertical "figure" glow in the middle of some screens
    float fig = step(0.5, seed) * smoothstep(0.9, 0.2, abs(q.x)) * smoothstep(0.0, 1.5, q.y) * smoothstep(5.0, 2.5, q.y);
    float v = clamp(n * 1.4 - 0.1 + fig * 0.6, 0.0, 1.0);
    v = floor(v * 5.0) / 5.0;                                        // posterised levels
    vec3 col = mix(TEAL * 0.12, TEAL, v);
    col = mix(col, MINT, step(0.8, v));
    col = mix(col, ORANGE, step(0.995, h21(g + tq * 0.1 + seed)));  // stray warm pixels
    vec2 f = abs(fract(uv / cell) - 0.5);
    col *= 0.7 + 0.3 * step(max(f.x, f.y), 0.42);                     // pixel gaps
    col *= 0.85 + 0.15 * step(0.5, fract(uv.y / cell * 0.5 + T * 2.0)); // scanline roll
    return col;
}

// printed graphics: returns rgba (rgb = ink colour, a = coverage)
vec4 prints(vec2 uv, float hw, float h, float seed, bool onWhite) {
    vec4 o = vec4(0);
    vec3 ink = onWhite ? INKC : PAPER;
    float side = seed > 0.5 ? 1.0 : -1.0;
    // vertical strip near one edge with ATTACH HERE running up it
    float sx = side * (hw - 0.22);
    float strip = step(abs(uv.x - sx), 0.12) * step(0.15, uv.y) * step(uv.y, h - 0.15);
    if (strip > 0.0) {
        o = vec4(onWhite ? INKC : vec3(0.02), 0.92);
        float fs = 0.024;
        vec2 g = vec2(uv.y - 0.3, (uv.x - sx) + 3.5 * fs) / fs;            // reads upward
        float tx = textLine(floor(g), T_AH, N_AH);
        if (tx > 0.0) o = vec4(onWhite ? PAPER : PAPER, 1.0);
    }
    // big cross
    vec2 cp = uv - vec2(-side * hw * 0.3, h * (0.25 + 0.3 * h11(seed * 7.0)));
    float cr = min(sdBox(cp, vec2(0.38, 0.035)), sdBox(cp, vec2(0.035, 0.38)));
    if (cr < 0.0) o = vec4(ink, 1.0);
    // small cross nearby
    vec2 cp2 = cp - vec2(side * 0.55, -0.4);
    float cr2 = min(sdBox(cp2, vec2(0.12, 0.022)), sdBox(cp2, vec2(0.022, 0.12)));
    if (cr2 < 0.0) o = vec4(ink, 1.0);
    // hazard stripes along the bottom
    if (uv.y < 0.28 && uv.y > 0.08) {
        float hz = step(0.5, fract((uv.x + uv.y) * 4.0));
        o = mix(o, vec4(ink, 0.9), hz);
    }
    // label + barcode block
    vec2 lp = uv - vec2(-side * (hw - 0.25) - (side > 0.0 ? 0.0 : 0.6), h - 0.7);
    float fs2 = 0.02;
    float lab = textLine(floor(lp / fs2), seed > 0.7 ? T_WAY : T_UNIT, seed > 0.7 ? N_WAY : N_UNIT);
    if (lab > 0.0) o = vec4(ink, 1.0);
    vec2 bp = lp - vec2(0.0, -0.25);
    if (bp.x > 0.0 && bp.x < 0.6 && bp.y > 0.0 && bp.y < 0.12 && h11(floor(bp.x / 0.015) + seed * 9.0) > 0.45) o = vec4(ink, 1.0);
    // corner registration marks
    vec2 cm = vec2(hw - abs(uv.x), h - uv.y);
    if (cm.y < 0.09 && cm.x < 0.09 && min(cm.x, cm.y) < 0.02) o = vec4(ink, 0.9);
    return o;
}

// trace one ray through the panel rows; returns colour, and the distance where
// it ended (floor or far)
vec3 traceHall(vec3 ro, vec3 rd, bool reflection, out float tEnd, out float trOut) {
    float tFloor = rd.y < 0.0 ? -ro.y / rd.y : 1e5;
    tEnd = tFloor;
    vec3 acc = vec3(0);
    float tr = 1.0;
    float k0 = floor(ro.z / ROW) - 1.0;
    for (int r = 0; r < ROWS; r++) {
        float k = k0 + float(r);
        // left/right panels of this row, nearer one first
        for (int si = 0; si < 2; si++) {
            float side = (si == 0) == (rd.x < 0.0) ? -1.0 : 1.0;
            Panel P = panelAt(k, side);
            float dn = dot(rd, P.n);
            if (abs(dn) < 1e-4) continue;
            float t = dot(P.c - ro, P.n) / dn;
            if (t <= 0.0 || t > tFloor) continue;
            vec3 hp = ro + rd * t;
            float u = dot(hp - P.c, P.tdir), v = hp.y;
            if (abs(u) > P.hw || v < 0.0 || v > P.h) continue;
            PXW = t * 0.0012 + 0.002;
            if (dn > 0.0) u = -u;              // seen from behind: keep prints readable
            vec2 uv = vec2(u, v);
            float fog = exp(-t * 0.045);
            vec3 c; float a;
            float edge = fillW(min(P.hw - abs(u), min(v, P.h - v)) - 0.02);      // 1 on the frame rim, 0 inside
            if (P.kind == 1) {
                c = mosaic(uv, P.seed) * 1.15;
                a = 0.92;
                c = mix(c, vec3(0.02), edge);
            } else if (P.kind == 2) {
                c = PAPER * (0.75 + 0.25 * smoothstep(0.0, P.h, v));
                vec4 pr = prints(uv, P.hw, P.h, P.seed, true);
                c = mix(c, pr.rgb, pr.a);
                a = 1.0;
            } else {
                // frosted glass: milky teal veil, prints on it, bright edge
                c = mix(TEAL * 0.25, MINT * 0.35, smoothstep(0.0, P.h, v));
                vec4 pr = prints(uv, P.hw, P.h, P.seed, false);
                c = mix(c, pr.rgb, pr.a);
                a = mix(0.28, 1.0, pr.a);
                c += MINT * edge * 0.6;
                a = max(a, edge * 0.8);
            }
            // light streak sweeping across glass and boards
            float streak = smoothstep(0.03, 0.0, abs(fract((u * 0.6 + v * 0.25) * 0.5 - T * 0.03 + P.seed) - 0.5) - 0.48);
            c += vec3(0.8, 1.0, 0.95) * streak * 0.35 * (P.kind == 1 ? 0.3 : 1.0);
            c = mix(DEEP, c, fog);
            if (reflection && P.kind != 1) c *= 0.4;
            acc += tr * a * c;
            tr *= 1.0 - a;
            if (tr < 0.02) { tEnd = t; trOut = 0.0; return acc; }
        }
    }
    // far: deep teal haze with a big distant screen glow
    vec3 far = mix(DEEP, TEAL * 0.35, smoothstep(0.4, 0.0, abs(rd.x)) * smoothstep(-0.1, 0.25, rd.y) * smoothstep(0.7, 0.2, rd.y));
    if (rd.y >= 0.0 || reflection) { acc += tr * far; tEnd = 1e5; trOut = 0.0; return acc; }
    trOut = tr;                        // the floor shows through with this weight
    return acc;
}

vec3 floorCol(vec3 p) {
    // zebra bands across the hall, chevron strips, tiles, stencil text
    vec3 col = vec3(0.030, 0.034, 0.034);
    float z = p.z, x = p.x;
    float band = floor(z / 1.6);
    float kb = h11(band);
    if (abs(x) < HALL - 0.2) {
        if (kb < 0.35) {
            float st = step(0.5, fract(x * 2.2));
            col = mix(col, PAPER * 0.75, st * step(abs(fract(z / 1.6) - 0.5), 0.3));
        } else if (kb < 0.55) {
            float ch = step(0.5, fract((abs(x) * 1.0 + z) * 2.0));
            col = mix(col, PAPER * 0.7, ch * step(abs(fract(z / 1.6) - 0.5), 0.12));
        } else if (kb < 0.75) {
            vec2 tq = fract(vec2(x, z) * 1.25) - 0.5;
            col = mix(col, vec3(0.08), step(max(abs(tq.x), abs(tq.y)), 0.42));
        }
        // stencil text across the hall
        if (kb > 0.85) {
            float fs = 0.06;
            vec2 g = vec2(x + 1.2, z - band * 1.6 - 0.6) / fs;
            col = mix(col, PAPER * 0.8, textLine(floor(g), T_ENJ, N_ENJ));
        }
    } else {
        // outside the walkway: grated metal
        vec2 gq = abs(fract(vec2(x, z) * 6.0) - 0.5);
        col = vec3(0.025, 0.03, 0.03) * (0.7 + 0.3 * step(0.35, max(gq.x, gq.y)));
    }
    // edge lines of the walkway
    col = mix(col, LIME * 0.7, smoothstep(0.03, 0.0, abs(abs(x) - HALL + 0.1)) * 0.5);
    return col;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    T = iTime;
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;
    vec3 ro = vec3(sin(T * 0.06) * 0.5, 1.75 + sin(T * 0.4) * 0.02, T * SPEED);
    float yaw = sin(T * 0.045) * 0.12;
    vec3 rd = normalize(vec3(uv.x, uv.y - 0.12, 1.1));
    rd.xz = mat2(cos(yaw), -sin(yaw), sin(yaw), cos(yaw)) * rd.xz;

    float tEnd, trn;
    vec3 col = traceHall(ro, rd, false, tEnd, trn);
    if (trn > 0.0) {
        float tFloor = -ro.y / rd.y;
        vec3 fp = ro + rd * tFloor;
        vec3 fc = floorCol(fp);
        // glossy floor: reflect the hall (screens stay bright, the rest dims)
        vec3 rr = normalize(reflect(rd, vec3(0, 1, 0)) + vec3((h21(fragCoord) - 0.5) * 0.04, 0.0, 0.0));
        float te2, tr2;
        fc += traceHall(fp + vec3(0, 0.001, 0), rr, true, te2, tr2) * 0.35;
        fc = mix(DEEP, fc, exp(-tFloor * 0.045));
        col += trn * fc;
    }

    vec2 vv = fragCoord / iResolution.xy - 0.5;
    col *= 1.0 - dot(vv, vv) * 0.9;
    col += (h21(fragCoord + fract(T) * 91.0) - 0.5) * GRAIN;
    fragColor = vec4(max(col, 0.0), 1.0);
}
