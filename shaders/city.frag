// fps: 30
// CITY: CyAc-style block city seen from above in perspective. Uniform square
// towers packed tight, glowing toward their tops and falling into navy dark.
// Faces carry storey lines, window grids, text, LED strips and accent bands;
// roofs carry sub-panels, text and lights. Lights cluster in drifting hotspots.
// MIRROR folds the screen like the kaleidoscope render.
// Text lives in the @text block; run tools/gentext.py after editing it.

// ---- tweakables --------------------------------------------------------
const int   MIRROR   = 0;      // 0 none, 1 left/right, 2 left/right + top/bottom
const float SPEED    = 0.35;   // camera glide (world units / s)
const float CAM_H    = 22.0;   // camera height
const float PITCH    = 0.95;   // look-down angle in radians (~54 deg)
const float FOV      = 1.0;    // larger = wider
const float STEP_H   = 0.5;    // storey height; tower heights are multiples
const float DENSITY  = 1.0;    // amount of lights
const float TEXT_DENSITY = 0.7; // amount of text (1.0 = previous, busier look)
const float HOT_SIZE = 7.0;    // hotspot size, world units
const float GRAIN    = 0.03;
const float SIDE_ALPHA = 0.6;  // how opaque tower walls are (1 = solid)
const float ROOF_ALPHA = 0.7;  // how opaque roofs are
const float INNER_PASS = 0.75; // how much light makes it through the interior
const float BASE_ALPHA = 0.95; // wall opacity at street level (walls fade from SIDE_ALPHA at the top to this)
const float LOW_FOG_H   = 8.0;  // black mist rises to about this height (world units)
const float LOW_FOG_POW = 1.8;  // higher = mist stays darker further up
const vec3  LOW_FOG     = vec3(0.000, 0.003, 0.010);
const float FROST      = 0.07; // frosted-glass scatter (0 = clear glass)
const float FROST_VEIL = 0.10; // milky haze on the glass
const float CORE_CHANCE = 0.5; // share of towers with a solid core
const float CORE_GLOW   = 2.2; // core brightness as seen through the glass
const float CORE_BLUR   = 0.09; // how much the frosted glass blurs the core (0 = sharp)
const int   CORE_SAMPLES = 6;   // rays used for the blur (more = smoother, slower)
const float CORE_MILK   = 0.12; // milky haze between the glass and the core

const vec3 GROUND = vec3(0.004, 0.010, 0.035);
const vec3 FOG    = vec3(0.006, 0.014, 0.050);
const vec3 LIME   = vec3(0.580, 0.920, 0.120);
const vec3 GREEN  = vec3(0.250, 0.560, 0.120);
const vec3 MOSS   = vec3(0.070, 0.160, 0.060);
const vec3 BLUE   = vec3(0.100, 0.200, 1.000);
const vec3 NAVY   = vec3(0.030, 0.060, 0.260);
const vec3 ICE    = vec3(0.600, 0.780, 1.000);
const vec3 MINT   = vec3(0.450, 1.000, 0.600);
const vec3 WHITE  = vec3(0.900, 0.950, 0.900);
const vec3 ORANGE = vec3(1.000, 0.450, 0.080);

// @text
// L0 INIT.S.1901.402
// L1 FUNC.D_10.2-L
// L2 FB_TR [FULL]
// L3 TR.P 10.
// L4 CTRL.ASL.0346
// L5 SEC.455
// L6 23940823.10288
// L7 029 1009.283
// L8 08834.192
// L9 12888.230
// LA 0010K
// LB NODE 7 // RELAY
// LC SUBSTRATE 04-B
// LD UPLINK [ACTIVE]
// LE MEM.BLK 0X3F00
// LF II I III  I II
// @endtext
// @gen  (generated by tools/gentext.py from the @text block - don't edit by hand)
const uint FONT[185] = uint[](0u,0u,0u,0u,0u,8u,8u,8u,8u,8u,0u,96u,96u,0u,0u,32u,16u,8u,4u,2u,62u,81u,73u,69u,62u,0u,66u,127u,64u,0u,66u,97u,81u,73u,70u,33u,65u,69u,75u,49u,24u,20u,18u,127u,16u,39u,69u,69u,69u,57u,60u,74u,73u,73u,48u,1u,113u,9u,5u,3u,54u,73u,73u,73u,54u,6u,73u,73u,41u,30u,126u,17u,17u,17u,126u,127u,73u,73u,73u,54u,62u,65u,65u,65u,34u,127u,65u,65u,34u,28u,127u,73u,73u,73u,65u,127u,9u,9u,9u,1u,0u,65u,127u,65u,0u,127u,8u,20u,34u,65u,127u,64u,64u,64u,64u,127u,2u,12u,2u,127u,127u,4u,8u,16u,127u,62u,65u,65u,65u,62u,127u,9u,9u,9u,6u,127u,9u,25u,41u,70u,70u,73u,73u,73u,49u,1u,1u,127u,1u,1u,63u,64u,64u,64u,63u,31u,32u,64u,32u,31u,99u,20u,8u,20u,99u,7u,8u,112u,8u,7u,0u,127u,65u,65u,0u,0u,65u,65u,127u,0u,64u,64u,64u,64u,64u);
const int TXT[189] = int[](20,24,20,29,2,28,2,5,13,4,5,2,8,4,6,19,30,24,16,2,17,36,5,4,2,6,1,22,19,15,36,29,27,0,34,19,30,22,22,35,29,27,2,26,0,5,4,2,16,29,27,22,2,14,28,22,2,4,7,8,10,28,18,16,2,8,9,9,6,7,13,8,4,12,6,7,2,5,4,6,12,12,4,6,13,0,5,4,4,13,2,6,12,7,4,12,12,7,8,2,5,13,6,5,6,12,12,12,2,6,7,4,4,4,5,4,21,24,25,17,18,0,11,0,3,3,0,27,18,22,14,33,28,30,15,28,29,27,14,29,18,0,4,8,1,15,30,26,22,20,24,21,0,34,14,16,29,20,31,18,35,23,18,23,2,15,22,21,0,4,32,7,19,4,4,20,20,0,20,0,20,20,20,0,0,20,0,20,20);
#define T_L0 0
#define N_L0 15
#define T_L1 15
#define N_L1 13
#define T_L2 28
#define N_L2 12
#define T_L3 40
#define N_L3 8
#define T_L4 48
