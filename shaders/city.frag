// p in font pixels (glyph = 5x7, advance 6), origin bottom-left of the line.
// One glyph, q in font pixels inside its 6x7 cell.
float glyphPix(vec2 q, int g) {
    int col = int(q.x), row = 6 - int(q.y);
    if (col < 0 || col > 4 || row < 0 || row > 6) return 0.0;
    return float((FONT[g * 5 + col] >> uint(row)) & 1u);
}
float textLine(vec2 p, int start, int len) {
    if (p.y < 0.0 || p.y >= 7.0 || p.x < 0.0 || p.x >= float(len) * 6.0) return 0.0;
    int ci = int(p.x) / 6;
    return glyphPix(vec2(p.x - float(ci * 6), p.y), TXT[start + ci]);
}
// @endgen

const int LS[16] = int[](T_L0,T_L1,T_L2,T_L3,T_L4,T_L5,T_L6,T_L7,T_L8,T_L9,T_LA,T_LB,T_LC,T_LD,T_LE,T_LF);
const int LN[16] = int[](N_L0,N_L1,N_L2,N_L3,N_L4,N_L5,N_L6,N_L7,N_L8,N_L9,N_LA,N_LB,N_LC,N_LD,N_LE,N_LF);

float h11(float n) { return fract(sin(n * 127.1) * 43758.5453); }
float h21(vec2 p)  { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vnoise(vec2 p) {
    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(h21(i), h21(i + vec2(1, 0)), f.x), mix(h21(i + vec2(0, 1)), h21(i + vec2(1, 1)), f.x), f.y);
}
vec3 lightCol(float k) { return k < 0.38 ? ICE : k < 0.6 ? WHITE : k < 0.85 ? MINT : ORANGE; }

float T, HOT;
const float HMAX = 16.0;

// ---- city layout -------------------------------------------------------
// Grid cell = half a world unit. Blocks are 9x9 cells: two 4-cell towers
// each way and a 1-cell street. Every tower is the same 2x2-unit square.
const float GS = 2.0;
const float BLK = 9.0;
float towerH(vec2 tid) {          // world units, multiple of STEP_H, 0 = empty lot
    float k = h21(tid);
    if (k < 0.05) return 0.0;
    // three height classes so the skyline has real contrast:
    // low podiums, mid-rises and tall towers
    float kc = h21(tid + 1.7), kv = h21(tid + 4.1);
    float h = kc < 0.4 ? mix(1.0, 2.5, kv) : kc < 0.75 ? mix(3.5, 6.5, kv) : mix(9.0, HMAX, kv);
    return clamp(floor(h / STEP_H) * STEP_H, STEP_H * 2.0, HMAX);
}
vec2 towerOf(vec2 c, out bool street) {
    vec2 blk = floor(c / BLK), l = c - blk * BLK;
    street = l.x > BLK - 1.5 || l.y > BLK - 1.5;
    return blk * 2.0 + floor(l / 4.0);
}
float heightAt(vec2 c) {          // grid units
    bool st; vec2 tid = towerOf(c, st);
    return st ? 0.0 : towerH(tid) * GS;
}
vec2 towerLocal(vec2 g) { vec2 blk = floor(g / BLK), l = g - blk * BLK; return (l - floor(l / 4.0) * 4.0) / GS; }

float label(vec2 g, int li, float id) {
    int shown = int(fract(T * 0.03 + id) * 160.0);
    return textLine(floor(g), LS[li], min(LN[li], shown));
}

// ---- side faces --------------------------------------------------------
// u across the face (0..2), z height, h tower height
vec3 shadeSide(vec3 base, float u, float z, float h, float kt, out vec3 glow) {
    glow = vec3(0);
    float g = pow(clamp(z / h, 0.0, 1.0), 1.5);
    float lum = 0.12 + 0.95 * g;                  // emissive falloff toward the street
    vec3 col = base * lum;
    float wz = max(fwidth(z), 0.002);
    float st = floor(z / STEP_H), fz = z - st * STEP_H;
    float ks = h21(vec2(st, kt * 50.0));
    float kind = h21(vec2(st * 1.3, kt * 91.0));

    // storey tone + accent bands
    col *= 0.75 + 0.45 * ks;
    if (ks > 0.9) col = (base.b > base.g ? LIME : BLUE) * (0.15 + 1.0 * g);

    // dot-matrix screen door (fades out where it would alias)
    vec2 dm = vec2(u, z) / 0.05;
    float aa = clamp(1.0 - fwidth(dm.x) * 1.5, 0.0, 1.0);
    vec2 f = abs(fract(dm) - 0.5);
    col *= mix(1.0, 0.6 + 0.4 * step(max(f.x, f.y), 0.32), aa);

    float hotP = (0.08 + 0.55 * HOT) * DENSITY;
    if (kind < 0.42) {
        // window slots
        vec2 wc = vec2(u / 0.16, fz / (STEP_H / 4.0));
        vec2 c = floor(wc), cf = fract(wc);
        float inW = step(0.2, cf.x) * step(cf.x, 0.8) * step(0.25, cf.y) * step(cf.y, 0.75)
                  * step(0.5, c.y) * step(c.y, 2.5) * step(0.12, u) * step(u, 1.88);
        float lit = step(1.0 - hotP, h21(c + vec2(st * 17.0, kt * 9.0) + floor(T * 0.12 + h21(c) * 4.0)));
        col = mix(col, col * 0.3, inW);
        glow += lightCol(h21(c + vec2(3.0, kt))) * inW * lit * (0.5 + 0.5 * g);
    } else if (kind < 0.6) {
        // a line of text per storey
        float fs = 0.03;
        vec2 gp = vec2(u - 0.12, fz - STEP_H * 0.28) / fs;
        int li = int(h21(vec2(kt, st)) * 16.0);
        vec3 ink = base.b > base.g ? ICE : MINT;
        col = mix(col, ink * (0.25 + 0.9 * g), label(gp, li, kt + st * 0.1) * step(h21(vec2(st, kt)), (0.4 + 0.5 * HOT) * TEXT_DENSITY));
    } else if (kind < 0.72) {
        // LED strip
        float row = step(abs(fz - STEP_H * 0.5), 0.025);
        vec2 c = floor(vec2(u / 0.06, 0.0));
        float on = step(0.5, h21(c + floor(T * (0.6 + kind)) + kt));
        float sq = step(abs(fract(u / 0.06) - 0.5), 0.3);
        glow += lightCol(h21(vec2(floor(u / 0.5), st + kt))) * row * sq * on * step(h21(vec2(kt, st + 3.0)), hotP * 1.4) * 0.9;
    } else if (kind < 0.82) {
        // vertical ribs
        col *= 0.8 + 0.25 * step(0.5, fract(u * 10.0));
    }
    // corner edges
    col *= mix(0.6, 1.0, smoothstep(0.0, 0.04, min(u, 2.0 - u)));
    // light strip on the roof edge
    if (h11(kt * 41.0) > 1.0 - 0.35 * HOT * DENSITY) glow += lightCol(h11(kt * 3.0)) * smoothstep(0.035, 0.0, h - z);
    return col;
}

// ---- roofs -------------------------------------------------------------
vec3 shadeTop(vec3 base, vec2 q, float kt, out vec3 glow) {
    glow = vec3(0);
    float w = max(fwidth(q.x), 0.002);
    vec2 sp = floor(q / 0.5);
    float tone = h21(sp + kt * 17.0);
    vec3 col = base * (1.0 + 0.35 * tone);
    if (tone > 0.88) col = mix(base, MOSS * 0.5, 0.7);
    col *= mix(0.55, 1.0, smoothstep(0.0, 0.05, min(min(q.x, 2.0 - q.x), min(q.y, 2.0 - q.y))));
    vec2 dm = abs(fract(q / 0.05) - 0.5);
    col *= 0.75 + 0.25 * step(max(dm.x, dm.y), 0.32);

    vec3 ink = base.b > base.g ? ICE : (base.g > 0.8 ? vec3(0.05, 0.12, 0.02) : MINT);
    // text block
    if (h11(kt * 5.0) < (0.35 + 0.5 * HOT) * TEXT_DENSITY) {
        float fs = 0.028;
        int li = int(h11(kt * 91.0) * 16.0);
        int rows = 1 + int(h11(kt * 17.0) * 3.0);
        for (int r = 0; r < 3; r++) {
            if (r >= rows) break;
            vec2 gp = (q - vec2(0.15, 1.7 - float(r) * 9.0 * fs)) / fs;
            col = mix(col, ink, 0.9 * label(gp, (li + r * 5) % 16, kt + float(r) * 0.1));
        }
    }
    // LED row
    if (h11(kt * 13.0) < (0.1 + 0.5 * HOT) * DENSITY) {
        float row = step(abs(q.y - 0.3), 0.03) * step(0.15, q.x) * step(q.x, 1.85);
        float on = step(0.45, h21(floor(vec2(q.x / 0.07, T * 1.3))));
        float sq = step(abs(fract(q.x / 0.07) - 0.5), 0.3);
        glow += lightCol(h11(kt * 7.0)) * row * on * sq;
    }
    // dot clusters + orange beacons
    vec2 dc = floor(q / 0.2), df = fract(q / 0.2) - 0.5;
    float k = h21(dc + kt * 5.0);
    float dotP = (0.02 + 0.12 * HOT) * DENSITY;
    if (k > 1.0 - dotP) glow += lightCol(h21(dc)) * smoothstep(0.32, 0.2, length(df)) * 0.8;
    else if (k < 0.012) glow += ORANGE * step(0.35, fract(T * (0.3 + k * 40.0))) * smoothstep(0.25, 0.12, length(df)) * 1.3;
    // barcode
    if (h11(kt * 29.0) > 0.6) {
        float inB = step(abs(q.y - 1.0), 0.04) * step(0.6, q.x) * step(q.x, 1.6);
        col = mix(col, ink, inB * step(0.45, h11(floor(q.x / 0.025) + kt * 11.0)) * 0.85);
    }
    return col;
}

// DDA through the height field starting at ray distance t. axis = which
// grid line the ray just crossed (-1 none), so a tower directly behind the
// one we left is seen as a wall, not a roof.
void trace(vec3 ro, vec3 rd, float t, int axis, out int face, out vec2 cell, out float tHit, out float h) {
    vec3 p = ro + rd * t;
    cell = floor(p.xy);
    vec2 stp = sign(rd.xy);
    vec2 tDelta = abs(1.0 / rd.xy);
    vec2 tMax = t + ((cell + max(stp, 0.0)) - p.xy) / rd.xy;
    float tEnter = t;
    face = -1; tHit = 1e9; h = 0.0;
    for (int i = 0; i < 300; i++) {
        h = heightAt(cell);
        float zIn = ro.z + rd.z * tEnter;
        float tExit = min(tMax.x, tMax.y);
        if (zIn <= h && axis >= 0) { face = axis == 0 ? 1 : 2; tHit = tEnter; return; }
        if (ro.z + rd.z * tExit <= h) { tHit = (h - ro.z) / rd.z; face = h > 0.0 ? 0 : 3; return; }
        tEnter = tExit;
        if (tMax.x < tMax.y) { tMax.x += tDelta.x; cell.x += stp.x; axis = 0; }
        else                 { tMax.y += tDelta.y; cell.y += stp.y; axis = 1; }
    }
}
// 0 = fully lost in the low black mist, 1 = clear. Slowly drifting edge.
float lowMist(vec2 xy, float z) {
    float n = vnoise(xy * 0.25 + vec2(T * 0.03, -T * 0.02)) - 0.5;
    return pow(smoothstep(0.0, LOW_FOG_H, z + n * 1.6), LOW_FOG_POW);
}
vec3 groundCol(vec2 xy) {
    vec2 g = xy * 3.0, gc = floor(g);
    float k = h21(gc);
    return GROUND + (k > 0.97 ? (h21(gc + 1.0) > 0.5 ? BLUE * 1.3 : MINT) : vec3(0)) *
           smoothstep(0.2, 0.0, length(fract(g) - 0.5)) * (0.5 + 0.5 * sin(T + k * 30.0));
}

// ---- main --------------------------------------------------------------
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    T = iTime;
    vec2 fc = fragCoord;
    if (MIRROR >= 1) fc.x = iResolution.x * 0.5 - abs(fc.x - iResolution.x * 0.5);
    if (MIRROR >= 2) fc.y = iResolution.y * 0.5 - abs(fc.y - iResolution.y * 0.5);
    vec2 uv = (fc - 0.5 * iResolution.xy) / iResolution.y;

    vec3 ro = vec3(2.5 + sin(T * 0.03) * 3.0, T * SPEED, CAM_H);
    vec3 fw = normalize(vec3(0.15, cos(PITCH), -sin(PITCH)));
    vec3 rt = normalize(cross(fw, vec3(0, 0, 1)));
    vec3 up = cross(rt, fw);
    vec3 rd = normalize(fw + FOV * (uv.x * rt + uv.y * up));

    ro *= GS;
    float t = (ro.z - HMAX * GS) / -rd.z, t0 = t;
    int axis = -1;
    vec3 acc = vec3(0);
    float tr = 1.0;                                   // remaining transmittance
    for (int layer = 0; layer < 3; layer++) {
        int face; vec2 cell; float tHit, h;
        trace(ro, rd, t, axis, face, cell, tHit, h);
        if (face < 0) break;
        vec3 hg = ro + rd * tHit, hp = hg / GS;
        float fogf = 1.0 - exp(-(tHit - t0) / GS * 0.035);
        if (face == 3) { acc += tr * mix(LOW_FOG, groundCol(hp.xy), 0.15); tr = 0.0; break; }

        bool st; vec2 tid = towerOf(cell, st);
        vec2 tq = towerLocal(hg.xy);
        float hw = h / GS;
        float kt = h21(tid + 0.71);
        HOT = smoothstep(0.42, 0.78, vnoise(tid * 2.0 / HOT_SIZE + vec2(0.0, T * 0.01)));
        vec3 base = kt < 0.34 ? GREEN : kt < 0.52 ? LIME : kt < 0.68 ? MOSS : kt < 0.86 ? NAVY : BLUE;
        bool blueSide = h11(kt * 13.0) > 0.78;
        vec3 surf, glow;
        if (face == 0) surf = shadeTop(base, tq, kt, glow);
        else if (face == 1) surf = shadeSide((blueSide && base.g > base.b) ? BLUE * 0.8 : base, tq.y, hp.z, hw, kt, glow);
        else { surf = shadeSide(base, tq.x, hp.z, hw, kt + 0.3, glow) * 0.75; }
        float A = face == 0 ? ROOF_ALPHA : mix(BASE_ALPHA, SIDE_ALPHA, pow(clamp(hp.z / hw, 0.0, 1.0), 0.8));

        // ---- inside the tower: where does the ray leave its box?
        // frosted glass: scatter the ray a little as it enters (static per pixel)
        if (FROST > 0.0) {
            vec3 P = ro + rd * tHit;
            vec2 n = vec2(h21(fragCoord + float(layer) * 17.3), h21(fragCoord.yx + 3.1 + float(layer)));
            rd = normalize(rd + FROST * vec3(n - 0.5, 0.0));
            ro = P - rd * tHit;
        }
        vec2 bmin = floor(cell / BLK) * BLK + floor((cell - floor(cell / BLK) * BLK) / 4.0) * 4.0;
        vec2 t1 = (bmin - ro.xy) / rd.xy, t2 = (bmin + 4.0 - ro.xy) / rd.xy;
        vec2 tfx = max(t1, t2);
        float tFz = -ro.z / rd.z;
        float tF = min(min(tfx.x, tfx.y), tFz);
        int exitAxis = tF == tfx.x ? 0 : (tF == tfx.y ? 1 : 2);

        // solid core: a 1x1-unit shaft in the middle, one storey short of the roof.
        // Seen through frosted glass: several rays fan out from the entry point,
        // so the core blurs more the further it sits behind the glass.
        bool coreHit = false;
        float coreCov = 0.0;                         // 0..1 how much of the view the core fills
        vec3 coreShade = vec3(0);
        if (h11(kt * 23.0) < CORE_CHANCE) {
            vec3 cmin = vec3(bmin + 1.0, 0.0), cmax = vec3(bmin + 3.0, h - STEP_H * GS);
            vec3 P0 = ro + rd * tHit;
            vec3 tA = normalize(cross(rd, vec3(0, 0, 1))), tB = cross(tA, rd);
            float rot = h21(fragCoord * 0.37 + float(layer)) * 6.2832;
            float tCentre = -1.0;
            for (int sIdx = 0; sIdx < CORE_SAMPLES; sIdx++) {
                // vogel disk, rotated per pixel
                float fs = float(sIdx);
                float rr = sqrt((fs + 0.5) / float(CORE_SAMPLES));
                float th = fs * 2.39996 + rot;
                vec3 rj = normalize(rd + CORE_BLUR * rr * (cos(th) * tA + sin(th) * tB));
                vec3 c1 = (cmin - P0) / rj, c2 = (cmax - P0) / rj;
                vec3 cn = min(c1, c2), cf = max(c1, c2);
                float tn = max(max(cn.x, cn.y), cn.z), tf = min(min(cf.x, cf.y), cf.z);
                if (!(tn <= tf && tf > 0.0)) continue;
                tn = max(tn, 0.0);
                vec3 cp = (P0 + rj * tn) / GS;
                float cz = clamp(cp.z / hw, 0.0, 1.0);
                vec3 cc = base.b > base.g ? ICE * 0.55 : LIME * 0.8;
                vec3 sh;
                if (tn == cn.z) sh = cc * 1.1;                         // core roof
                else {
                    float u = tn == cn.x ? cp.y : cp.x;
                    float fz = fract(cp.z / STEP_H);
                    float band = smoothstep(0.08, 0.0, abs(fz - 0.5) - 0.03);
                    float ribs = 0.75 + 0.25 * step(0.5, fract(u * 12.0));
                    sh = cc * (0.04 + 1.0 * pow(cz, 1.6)) * ribs * (tn == cn.x ? 1.0 : 0.7)
                       + cc * band * 0.6 * pow(cz, 1.2);
                }
                coreShade += sh;
                coreCov += 1.0;
                if (tCentre < 0.0 || sIdx == 0) tCentre = tHit + tn;
            }
            coreCov /= float(CORE_SAMPLES);
            coreShade /= float(CORE_SAMPLES);
            if (coreCov > 0.0) {
                tF = min(tF, max(tCentre, tHit));
                coreHit = coreCov > 0.99;
                // milky light scattered in the gap between glass and core
                float gap = (tF - tHit) / GS;
                coreShade += mix(vec3(0.75, 0.85, 0.9), base, 0.6) * CORE_MILK * coreCov * clamp(gap, 0.0, 1.5)
                           * (0.3 + 0.7 * pow(clamp(hp.z / hw, 0.0, 1.0), 1.2));
            }
        }
        // floor slabs crossed on the way through (seen through the glass)
        vec3 inner = vec3(0);
        float zA = hg.z / GS - 0.001, zB = (ro.z + rd.z * tF) / GS;
        float k0 = floor(zB / STEP_H) + 1.0, k1 = floor(zA / STEP_H);
        for (int k = 0; k < 20; k++) {
            float kz = k0 + float(k);
            if (kz > k1) break;
            float zp = kz * STEP_H;
            vec3 pp = ro / GS + rd * ((zp * GS - ro.z) / rd.z) / GS;
            vec2 lq = towerLocal(pp.xy * GS);
            float gz = pow(zp / hw, 1.5);
            // slab: faint fill, brighter edge and a grid of ceiling lights
            float edge = smoothstep(0.08, 0.0, min(min(lq.x, 2.0 - lq.x), min(lq.y, 2.0 - lq.y)));
            vec2 lc = abs(fract(lq / 0.4) - 0.5);
            float lamp = step(max(lc.x, lc.y), 0.08) * step(0.6, h21(floor(lq / 0.4) + kz + kt * 7.0));
            inner += base * (0.05 + 0.5 * edge) * gz + lightCol(h21(vec2(kz, kt))) * lamp * 0.5 * (0.3 + gz) * HOT;
        }
        // haze proportional to the distance travelled inside
        float thick = (tF - tHit) / GS;
        inner += base * thick * 0.06 * pow(clamp(0.5 * (zA + zB) / hw, 0.0, 1.0), 1.5);
        // inner side of the back wall
        if (exitAxis < 2 && !coreHit) inner += base * 0.12 * pow(clamp(zB / hw, 0.0, 1.0), 1.5);
        inner += coreShade * CORE_GLOW;

        // milky veil: brighter near the top where the glass catches the glow
        vec3 veil = mix(vec3(0.75, 0.85, 0.9), base, 0.5) * FROST_VEIL * (0.3 + 0.7 * pow(clamp(hp.z / hw, 0.0, 1.0), 1.2));
        // black mist at street level: surface fades by its own height, the
        // interior by the height where the ray leaves it (it is always lower)
        vec3 layerCol = mix(LOW_FOG, surf * A + glow + veil * (1.0 - A), lowMist(hp.xy, hp.z))
                      + inner * (1.0 - A) * lowMist(hp.xy, zB);
        if (coreHit) { acc += tr * mix(layerCol, FOG, fogf); tr = 0.0; break; }
        acc += tr * mix(layerCol, FOG, fogf);
        tr *= 1.0 - coreCov;                         // a partly covering (blurred) core edge
        tr *= (1.0 - A) * INNER_PASS;
        if (exitAxis == 2) {                     // left through the floor: street below
            acc += tr * LOW_FOG; tr = 0.0; break;
        }
        if (tr < 0.02) break;
        t = tF + 1e-3;
        axis = exitAxis;
    }
    vec3 col = acc + tr * FOG;

    vec2 v = fragCoord / iResolution.xy - 0.5;
    col *= 1.0 - dot(v, v) * 0.8;
    col += (h21(fragCoord + fract(T) * 91.0) - 0.5) * GRAIN;
    fragColor = vec4(max(col, 0.0), 1.0);
}
