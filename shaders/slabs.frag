// fps: 30
// SLABS: isometric CyAc-style architecture. A solid field of panel blocks in
// green, lime and electric blue, drifting slowly. Heights are whole multiples
// of STEP_PX. Tops carry sub-panels, microtext, LEDs and barcodes; sides carry
// window grids, floor lines and text.
// Text lives in the @text block; run tools/gentext.py after editing it.

// ---- tweakables --------------------------------------------------------
const float UNIT    = 92.0;   // screen px per world unit (horizontal) at 1440p
const float STEP_PX = 100.0;  // height of one storey in screen px at 1440p
const int   MAX_STOREYS = 4;  // blocks are 1..MAX_STOREYS storeys tall
const float SPEED   = 0.12;   // drift along the bands
const float GRAIN   = 0.03;
const float LOW_FOG_H   = 3.6;  // black mist rises to about this many storeys
const float LOW_FOG_POW = 1.8;  // higher = mist stays darker further up
const vec3  LOW_FOG     = vec3(0.000, 0.004, 0.010);

const vec3 VOID   = vec3(0.008, 0.016, 0.035);
const vec3 DARK   = vec3(0.035, 0.085, 0.045);
const vec3 MOSS   = vec3(0.110, 0.260, 0.070);
const vec3 GREEN  = vec3(0.330, 0.700, 0.120);
const vec3 LIME   = vec3(0.560, 0.900, 0.080);
const vec3 NAVY   = vec3(0.035, 0.070, 0.340);
const vec3 BLUE   = vec3(0.110, 0.230, 1.000);
const vec3 MINT   = vec3(0.420, 0.950, 0.640);
const vec3 ICE    = vec3(0.600, 0.780, 1.000);
const vec3 WHITE  = vec3(0.900, 0.950, 0.900);
const vec3 ORANGE = vec3(1.000, 0.450, 0.080);
const float DENSITY  = 1.0;    // overall amount of lights/text (0..~2)
const float HOT_SIZE = 9.0;    // size of the busy hotspots, world units

// @text
// L0 INIT.S.1901.402
// L1 FUNC.D_10.2-L
// L2 FB_TR [FULL]
// L3 TR.P 10.
// L4 CTRL.ASL.0346.3859-0000000-200
// L5 SEC.455
// L6 23940823.10288
// L7 029 1009.28309
// L8 08834.192
// L9 12888.230
// LA 0010K
// LB NODE 7 // RELAY
// LC SUBSTRATE 04-B
// LD UPLINK [ACTIVE]
// LE MEM.BLK 0X3F00
// LF II I III  I II
// @endtext
// @gen  (generated by tools/gentext.py from the @text block - don't edit by hand)
const uint FONT[185] = uint[](0u,0u,0u,0u,0u,8u,8u,8u,8u,8u,0u,96u,96u,0u,0u,32u,16u,8u,4u,2u,62u,81u,73u,69u,62u,0u,66u,127u,64u,0u,66u,97u,81u,73u,70u,33u,65u,69u,75u,49u,24u,20u,18u,127u,16u,39u,69u,69u,69u,57u,60u,74u,73u,73u,48u,1u,113u,9u,5u,3u,54u,73u,73u,73u,54u,6u,73u,73u,41u,30u,126u,17u,17u,17u,126u,127u,73u,73u,73u,54u,62u,65u,65u,65u,34u,127u,65u,65u,34u,28u,127u,73u,73u,73u,65u,127u,9u,9u,9u,1u,0u,65u,127u,65u,0u,127u,8u,20u,34u,65u,127u,64u,64u,64u,64u,127u,2u,12u,2u,127u,127u,4u,8u,16u,127u,62u,65u,65u,65u,62u,127u,9u,9u,9u,6u,127u,9u,25u,41u,70u,70u,73u,73u,73u,49u,1u,1u,127u,1u,1u,63u,64u,64u,64u,63u,31u,32u,64u,32u,31u,99u,20u,8u,20u,99u,7u,8u,112u,8u,7u,0u,127u,65u,65u,0u,0u,65u,65u,127u,0u,64u,64u,64u,64u,64u);
const int TXT[208] = int[](20,24,20,29,2,28,2,5,13,4,5,2,8,4,6,19,30,24,16,2,17,36,5,4,2,6,1,22,19,15,36,29,27,0,34,19,30,22,22,35,29,27,2,26,0,5,4,2,16,29,27,22,2,14,28,22,2,4,7,8,10,2,7,12,9,13,1,4,4,4,4,4,4,4,1,6,4,4,28,18,16,2,8,9,9,6,7,13,8,4,12,6,7,2,5,4,6,12,12,4,6,13,0,5,4,4,13,2,6,12,7,4,13,4,12,12,7,8,2,5,13,6,5,6,12,12,12,2,6,7,4,4,4,5,4,21,24,25,17,18,0,11,0,3,3,0,27,18,22,14,33,28,30,15,28,29,27,14,29,18,0,4,8,1,15,30,26,22,20,24,21,0,34,14,16,29,20,31,18,35,23,18,23,2,15,22,21,0,4,32,7,19,4,4,20,20,0,20,0,20,20,20,0,0,20,0,20,20);
#define T_L0 0
#define N_L0 15
#define T_L1 15
#define N_L1 13
#define T_L2 28
#define N_L2 12
#define T_L3 40
#define N_L3 8
#define T_L4 48
#define N_L4 30
#define T_L5 78
#define N_L5 7
#define T_L6 85
#define N_L6 14
#define T_L7 99
#define N_L7 14
#define T_L8 113
#define N_L8 9
#define T_L9 122
#define N_L9 9
#define T_LA 131
#define N_LA 5
#define T_LB 136
#define N_LB 15
