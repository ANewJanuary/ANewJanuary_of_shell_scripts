// p in font pixels (glyph = 5x7, advance 6), origin bottom-left of the line.
// One glyph, q in font pixels inside its 6x7 cell.
float glyphPix(vec2 q, int g) {
    int col = int(q.x), row = 6 - int(q.y);
    if (col < 0 || col > 4 || row < 0 || row > 6) return 0.0;
    return float((FONT[g * 5 + col] >> uint(row)) & 1u);
}
float textLine(vec2 p, int start, int len) {
    if (p.y < 0.0 || p.y >= 7.0 || p.x < 0.0 || p.x >= float(len) * 6.0) return 0.0;
    int ci = int(p.x) / 6;
    return glyphPix(vec2(p.x - float(ci * 6), p.y), TXT[start + ci]);
}
// @endgen

const int LS[16] = int[](T_L0,T_L1,T_L2,T_L3,T_L4,T_L5,T_L6,T_L7,T_L8,T_L9,T_LA,T_LB,T_LC,T_LD,T_LE,T_LF);
const int LN[16] = int[](N_L0,N_L1,N_L2,N_L3,N_L4,N_L5,N_L6,N_L7,N_L8,N_L9,N_LA,N_LB,N_LC,N_LD,N_LE,N_LF);

float h11(float n) { return fract(sin(n * 127.1) * 43758.5453); }
float h21(vec2 p)  { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

float vnoise(vec2 p) {
    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(h21(i), h21(i + vec2(1, 0)), f.x), mix(h21(i + vec2(0, 1)), h21(i + vec2(1, 1)), f.x), f.y);
}
// Light colour from a hash: mostly ice/white, some mint, a few orange.
vec3 lightCol(float k) {
    return k < 0.38 ? ICE : k < 0.6 ? WHITE : k < 0.85 ? MINT : ORANGE;
}
float HOT;     // 0..1 how busy this spot is (slow drifting hotspots)
float HS;      // storey height in world units
float T;       // time

// ---- world layout ------------------------------------------------------
// Lanes of width 2 along x, no gaps. Each lane is cut into segments of
// length L (2..5); every segment has its own storey count and colour.
float laneOf(float y) { return floor(y / 2.0); }
float segLen(float lane) { return 2.0 + floor(h11(lane * 1.7) * 4.0); }
float segOff(float lane) { return floor(h11(lane * 3.3) * 7.0); }
float segOf(float x, float lane) { return floor((x + segOff(lane)) / segLen(lane)); }

float storeys(float lane, float s) {
    float k = h21(vec2(lane, s));
    float n = 1.0 + floor(k * float(MAX_STOREYS));
    // now and then a block steps up or down one storey
    float pulse = step(0.8, h21(vec2(s, lane + 50.0))) * step(0.5, fract(T * 0.04 + k));
    return clamp(n + (n < float(MAX_STOREYS) ? pulse : -pulse), 1.0, float(MAX_STOREYS));
}
float heightAt(vec2 c) {
    float lane = laneOf(c.y);
    return storeys(lane, segOf(c.x, lane)) * HS;
}

// panel type per segment: 0 dark, 1 moss, 2 green, 3 lime, 4 navy, 5 blue
int panelType(float lane, float s) {
    float k = h21(vec2(s * 1.3, lane * 7.7 + 2.0));
    bool blueLane = h11(lane * 4.4) > 0.47;   // share of blue lanes (lower = more blue)
    if (blueLane) return k < 0.35 ? 0 : (k < 0.7 ? 4 : 5);
    if (k < 0.25) return 0;
    if (k < 0.5) return 1;
    if (k < 0.8) return 2;
    if (k < 0.92) return 3;
    return 5;
}
vec3 panelCol(int t) {
    return t == 0 ? DARK : t == 1 ? MOSS : t == 2 ? GREEN : t == 3 ? LIME : t == 4 ? NAVY : BLUE;
}
vec3 inkFor(int t) { return (t >= 4) ? ICE : (t == 3 ? vec3(0.05, 0.12, 0.02) : MINT); }

// text line li at glyph-space position g (font px), typed on its own clock
float label(vec2 g, int li, float id) {
    int shown = int(fract(T * 0.03 + id) * 160.0);
    return textLine(floor(g), LS[li], min(LN[li], shown));
}

// ---- top faces ---------------------------------------------------------
// q: x along the segment (0..L), y across the lane (0..2)
vec3 topFace(vec3 base, vec2 q, float L, int ty, float id, out vec3 glow) {
    glow = vec3(0);
    vec3 ink = inkFor(ty);
    float w = max(fwidth(q.x), 0.004);

    // sub-panels: 0.5 along, two rows across; each gets its own tone
    vec2 sp = vec2(floor(q.x / 0.5), floor(q.y));
    float tone = h21(sp + id * 17.0);
    vec3 col = base * (0.78 + 0.42 * tone);
    if (tone > 0.9) col = mix(base, DARK, 0.65);                  // dark inset panel
    else if (tone < 0.08) col = mix(base, vec3(1), 0.12);         // pale panel
    // seams between sub-panels
    vec2 f = vec2(fract(q.x / 0.5) * 0.5, fract(q.y));
    float seam = min(min(f.x, 0.5 - f.x), min(f.y, 1.0 - f.y));
    col *= mix(0.55, 1.0, smoothstep(0.0, w * 2.0, seam - 0.006));
    // segment bevel
    vec2 e = min(q, vec2(L, 2.0) - q);
    col *= mix(0.6, 1.0, smoothstep(0.0, 0.05, min(e.x, e.y)));

    // fine scanline texture on lit panels
    col *= 0.93 + 0.07 * step(0.5, fract(q.y * 36.0));

    // --- text: one or two blocks per segment, along or across
    float fs = 0.024 + 0.01 * h11(id * 13.0);
    for (int b = 0; b < 2; b++) {
        float bid = h11(id * 5.0 + float(b) * 3.7);
        if (bid < 1.0 - (0.25 + 0.55 * HOT) * DENSITY) continue;
        int li = int(h11(bid * 91.0) * 16.0);
        int rows = 1 + int(h11(bid * 7.0) * 3.0);
        for (int r = 0; r < 3; r++) {
            if (r >= rows) break;
            int l2 = (li + r * 5) % 16;
            vec2 g;
            if (bid > 0.6) {   // along the lane, letters stand toward +y
                vec2 o = vec2(0.15 + h11(bid) * (L - 2.0) * 0.5, 0.15 + float(b) * 1.0 + float(r) * 9.0 * fs);
                g = (q - o) / fs;
            } else {           // across the lane (reads up-right), letters stand toward -x
                vec2 o = vec2(L - 0.15 - h11(bid) * (L - 1.0), 0.15);
                g = vec2(q.y - o.y, (o.x - q.x) - float(r) * 9.0 * fs) / fs;
            }
            col = mix(col, ink, 0.9 * label(g, l2, bid + float(r) * 0.1));
        }
    }

    // --- LED strips: rows of small square lights in some sub-panels
    float lid = h21(sp + id * 3.0 + 9.0);
    if (lid > 1.0 - (0.04 + 0.3 * HOT) * DENSITY) {
        vec2 cell = floor(q / 0.075);
        vec2 cf = fract(q / 0.075) - 0.5;
        float row = step(abs(fract(q.y) - 0.82), 0.04);
        float on = step(0.45, h21(cell + floor(T * (0.5 + lid * 2.0))));
        float sq = step(max(abs(cf.x), abs(cf.y)), 0.28);
        vec3 lc = lightCol(h21(vec2(floor(q.x / 0.6), id)));
        glow += lc * row * on * sq * 1.1;
    }
    // --- dot clusters (round lights)
    if (lid < (0.03 + 0.3 * HOT) * DENSITY) {
        vec2 cell = floor(q / 0.16);
        vec2 cf = fract(q / 0.16) - 0.5;
        float on = step(0.8, h21(cell + id * 31.0));
        float blink = step(0.2, h21(cell + floor(T * 0.8 + id * 5.0)));
        glow += lightCol(h21(cell + 7.7)) * on * blink * smoothstep(0.32, 0.22, length(cf)) * 0.8;
    }
    // --- barcode stripe along one edge
    if (h11(id * 29.0) > 0.55) {
        float bx = q.x - 0.2;
        float inBar = step(0.0, bx) * step(bx, 1.0) * step(abs(q.y - 1.9), 0.05);
        float bars = step(0.45, h11(floor(bx / 0.03) + id * 11.0));
        col = mix(col, ink, inBar * bars * 0.85);
    }
    // --- glowing edge light along the lane side
    if (h11(id * 41.0) > 1.0 - 0.3 * HOT * DENSITY) {
        glow += lightCol(h11(id * 3.0)) * smoothstep(0.03, 0.0, q.y) * 0.7;
    }
    return col;
}

// ---- side faces --------------------------------------------------------
// u: horizontal coord along the face, z: height, H: block height
vec3 sideFace(vec3 base, float u, float z, float H, int ty, float id, float shade, out vec3 glow) {
    glow = vec3(0);
    vec3 col = base * shade;
    float wz = max(fwidth(z), 0.004);
    // storey lines
    float fz = fract(z / HS) * HS;
    col *= mix(0.45, 1.0, smoothstep(0.0, wz * 2.0, min(fz, HS - fz) - 0.01));
    float storey = floor(z / HS);

    // window grid: per storey, rows of lit slots
    float kind = h21(vec2(id * 7.0, storey));
    vec2 wc = vec2(u / 0.18, fz / (HS / 5.0));
    vec2 cell = floor(wc), cf = fract(wc);
    float inWin = step(0.18, cf.x) * step(cf.x, 0.82) * step(0.3, cf.y) * step(cf.y, 0.7);
    float band = step(1.0, cell.y) * step(cell.y, 3.0);           // keep a margin top/bottom
    if (kind > 0.35) {
        float litP = (0.06 + 0.45 * HOT) * DENSITY;
        float lit = step(1.0 - litP, h21(cell + vec2(storey * 31.0, id * 13.0) + floor(T * 0.15 + h21(cell) * 3.0)));
        vec3 lc = lightCol(h21(cell + vec2(5.0, id)));
        col = mix(col, base * shade * 0.35, inWin * band);       // unlit window = recess
        glow += lc * inWin * band * lit * (0.5 + 0.5 * h21(cell + 1.7));
    } else if (kind > 0.15) {
        // text on the side (reads along u)
        float fs = 0.026;
        vec2 g = vec2(u - 0.12, fz - HS * 0.35) / fs;
        int li = int(h21(vec2(id, storey)) * 16.0);
        col = mix(col, inkFor(ty) * shade * 1.6, label(g, li, id + storey));
    } else {
        // vertical ribs
        col *= 0.8 + 0.2 * step(0.5, fract(u * 8.0));
    }
    // light strip at the roof edge
    if (h11(id * 41.0) > 1.0 - 0.3 * HOT * DENSITY) glow += lightCol(h11(id * 3.0)) * smoothstep(0.03, 0.0, H - z) * 0.8;
    return col;
}

// ---- main --------------------------------------------------------------
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    T = iTime;
    float unit = UNIT * iResolution.y / 1440.0;
    HS = STEP_PX / UNIT;
    vec2 sp = (fragCoord - 0.5 * iResolution.xy) / unit;

    // parallel projection: screen.x = (x+y)*C, screen.y = (y-x)*S + z
    const float C = 0.8660254, Sn = 0.5;
    float ZTOP = HS * float(MAX_STOREYS) + 0.5;
    float A = sp.x / C, B = (sp.y - ZTOP) / Sn;
    vec3 ro = vec3((A - B) * 0.5, (A + B) * 0.5, ZTOP);
    ro.x += T * SPEED * 6.0 + 40.0;
    ro.y += 17.0;
    vec3 rd = vec3(-1.0, 1.0, -1.0);

    vec2 cell = floor(ro.xy);
    float tx = fract(ro.x), ty = 1.0 - fract(ro.y);
    float tt = 0.0;
    int face = 0, lastAxis = -1;
    vec3 hit = vec3(0);
    for (int i = 0; i < 80; i++) {
        float h = heightAt(cell);
        float zin = ZTOP - tt;
        float dt = min(tx, ty);
        if (zin <= h && lastAxis >= 0) { face = lastAxis == 0 ? 1 : 2; hit = ro + rd * tt; break; }
        if (zin - dt <= h) { hit = ro + rd * (ZTOP - h); face = 0; break; }
        tt += dt;
        if (tx < ty) { ty -= dt; tx = 1.0; cell.x -= 1.0; lastAxis = 0; }
        else         { tx -= dt; ty = 1.0; cell.y += 1.0; lastAxis = 1; }
    }

    float lane = laneOf(cell.y);
    float s = segOf(cell.x, lane);
    float H = storeys(lane, s) * HS;
    int typ = panelType(lane, s);
    vec3 base = panelCol(typ);
    float id = h21(vec2(lane, s) + 0.37);
    float L = segLen(lane);
    float x0 = s * L - segOff(lane);

    // hotspots: slow drifting blobs in world space, per segment so blocks light as a unit
    HOT = smoothstep(0.45, 0.8, vnoise(vec2(x0 + L * 0.5, lane * 2.0) / HOT_SIZE + vec2(0.0, T * 0.01)));

    // tiny orange beacons scattered on roofs, independent of hotspots
    vec3 beacon = vec3(0);

    vec3 col, glow;
    if (face == 0) {
        vec2 q = vec2(hit.x - x0, hit.y - lane * 2.0);
        col = topFace(base, q, L, typ, id, glow);
        vec2 bc = floor(q / 0.35), bf = fract(q / 0.35) - 0.5;
        float bk = h21(bc + id * 57.0);
        float blink = step(0.35, fract(T * (0.3 + bk) + bk * 9.0));
        glow += ORANGE * step(0.975, bk) * blink * smoothstep(0.14, 0.06, length(bf)) * 1.4;
    } else if (face == 2) {   // long side, faces -y (down-left)
        col = sideFace(base, hit.x - x0, hit.z, H, typ, id, 0.42, glow);
    } else {                  // end face, faces +x (down-right)
        col = sideFace(base, hit.y - lane * 2.0, hit.z, H, typ, id + 0.5, 0.62, glow);
    }
    // lower = darker: makes the storeys read
    col *= 0.5 + 0.5 * clamp(hit.z / (HS * float(MAX_STOREYS)), 0.0, 1.0);
    col += glow;
    // black mist pooling between the blocks: fades by absolute height, drifting edge
    float mn = vnoise(hit.xy * 0.18 + vec2(T * 0.03, -T * 0.02)) - 0.5;
    col = mix(LOW_FOG, col, pow(smoothstep(0.0, LOW_FOG_H * HS, hit.z + mn * HS * 0.8), LOW_FOG_POW));

    // gentle light falloff and vignette
    vec2 v = fragCoord / iResolution.xy - 0.5;
    col *= 1.0 - dot(v, v) * 0.7;
    col += (h21(fragCoord + fract(T) * 91.0) - 0.5) * GRAIN;
    fragColor = vec4(max(col, 0.0), 1.0);
}
