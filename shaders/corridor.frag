// fps: 30
// CORRIDOR: walking down a street canyon of panel-clad buildings
// (greenbox / redbox). Rows of buildings on both sides, each row split into
// separate buildings of different heights with alleys between them; rows
// further back are taller and show over and between the front ones.
// Facades are tiled with rounded panels of mixed sizes, each with a small
// indicator light; some panels are dark and stencilled with codes.
// THEME 0 = green/teal, 1 = red/magenta.
// Text lives in the @text block; run tools/gentext.py after editing it.

// ---- tweakables --------------------------------------------------------
const int   THEME   = 0;
const float SPEED   = 0.6;    // walking speed (units / s)
const float EYE     = 7.0;    // eye height above the street
const float NARROW  = 3.0;    // half width of the street (whole number)
const float LANE_W  = 5.0;    // building depth + 1-cell alley, per row of buildings
const float CROSS_P = 30.0;   // a cross street every this many units
const float CROSS_W = 5.0;    // cross street width
const float STEP    = 1.0;    // building heights are multiples of this
const float MIN_DH  = 4.0;    // neighbouring buildings in a row differ by at least this (multiple of STEP)
const float HMAX    = 60.0;
const float TMAX    = 160.0;  // view distance
const float FOG_D   = 0.022;  // distance fog density (lower = see further)
const float GRAIN   = 0.035;
const float LOW_MAX = 4.0;      // low blocks filling the gaps are 1..LOW_MAX storeys (STEP) tall
const float LOW_FOG_H   = 3.5;  // black mist rises to about this height
const float LOW_FOG_POW = 1.6;  // higher = mist stays darker further up
const vec3  LOW_FOG     = vec3(0.000, 0.004, 0.008);

// palette per theme
vec3 PANEL, PANEL_HI, PANEL_A, PANEL_B, GAP, FOGC, FOG_FAR, LED, LED2, INK, MOTE;
void setTheme() {
    if (THEME == 0) {
        PANEL    = vec3(0.075, 0.190, 0.180);
        PANEL_HI = vec3(0.140, 0.330, 0.300);
        PANEL_A  = vec3(0.070, 0.230, 0.080);   // greener buildings
        PANEL_B  = vec3(0.050, 0.120, 0.260);   // bluer buildings
        GAP      = vec3(0.010, 0.030, 0.030);
        FOGC     = vec3(0.030, 0.180, 0.110);
        FOG_FAR  = vec3(0.090, 0.420, 0.170);
        LED      = vec3(0.200, 0.650, 1.000);
        LED2     = vec3(0.830, 1.000, 0.000);
        INK      = vec3(0.180, 0.340, 0.320);
        MOTE     = vec3(0.600, 1.000, 0.800);
    } else {
        PANEL    = vec3(0.230, 0.030, 0.065);
        PANEL_HI = vec3(0.400, 0.060, 0.110);
        PANEL_A  = vec3(0.280, 0.060, 0.030);   // warmer buildings
        PANEL_B  = vec3(0.200, 0.030, 0.200);   // more magenta buildings
        GAP      = vec3(0.030, 0.004, 0.012);
        FOGC     = vec3(0.220, 0.020, 0.120);
        FOG_FAR  = vec3(0.520, 0.080, 0.300);
        LED      = vec3(1.000, 0.180, 0.080);
        LED2     = vec3(1.000, 0.700, 0.300);
        INK      = vec3(0.420, 0.080, 0.130);
        MOTE     = vec3(1.000, 0.700, 0.800);
    }
}

// @text
// C1 C200
// C2 XE 05
// C3 EP 87
// C4 VE-46
// C5 EE 44
// C6 B-17
// @endtext
// @gen  (generated by tools/gentext.py from the @text block - don't edit by hand)
const uint FONT[80] = uint[](0u,0u,0u,0u,0u,8u,8u,8u,8u,8u,62u,81u,73u,69u,62u,0u,66u,127u,64u,0u,66u,97u,81u,73u,70u,24u,20u,18u,127u,16u,39u,69u,69u,69u,57u,60u,74u,73u,73u,48u,1u,113u,9u,5u,3u,54u,73u,73u,73u,54u,127u,73u,73u,73u,54u,62u,65u,65u,65u,34u,127u,73u,73u,73u,65u,127u,9u,9u,9u,6u,31u,32u,64u,32u,31u,99u,20u,8u,20u,99u);
const int TXT[28] = int[](11,4,2,2,15,12,0,2,6,12,13,0,9,8,14,12,1,5,7,12,12,0,5,5,10,1,3,8);
#define T_C1 0
#define N_C1 4
#define T_C2 4
#define N_C2 5
#define T_C3 9
#define N_C3 5
#define T_C4 14
#define N_C4 5
#define T_C5 19
#define N_C5 5
#define T_C6 24
#define N_C6 4
// p in font pixels (glyph = 5x7, advance 6), origin bottom-left of the line.
// One glyph, q in font pixels inside its 6x7 cell.
float glyphPix(vec2 q, int g) {
    int col = int(q.x), row = 6 - int(q.y);
    if (col < 0 || col > 4 || row < 0 || row > 6) return 0.0;
    return float((FONT[g * 5 + col] >> uint(row)) & 1u);
}
float textLine(vec2 p, int start, int len) {
    if (p.y < 0.0 || p.y >= 7.0 || p.x < 0.0 || p.x >= float(len) * 6.0) return 0.0;
    int ci = int(p.x) / 6;
    return glyphPix(vec2(p.x - float(ci * 6), p.y), TXT[start + ci]);
}
// @endgen

float h11(float n) { return fract(sin(n * 127.1) * 43758.5453); }
float h21(vec2 p)  { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vnoise(vec2 p) {
    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(h21(i), h21(i + vec2(1, 0)), f.x), mix(h21(i + vec2(0, 1)), h21(i + vec2(1, 1)), f.x), f.y);
}
float sdRound(vec2 p, vec2 b, float r) { vec2 d = abs(p) - b + r; return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r; }

float T;

// Panel wall texture. q = 2D position on the wall (units), seed per wall,
// unit = panel size. Returns colour; adds emissive into glow.
vec3 panels(vec2 q, float seed, float unit, float dist, out vec3 glow) {
    glow = vec3(0);
    vec2 g = q / unit;
    // 2x2 macro cell picks a layout: one big, two wide, two tall or four small
    vec2 mc = floor(g / 2.0);
    vec2 l = g - mc * 2.0;
    float k = h21(mc + seed);
    vec2 pmin, psz;
    if (k < 0.2)       { pmin = vec2(0.0); psz = vec2(2.0); }
    else if (k < 0.4)  { pmin = vec2(0.0, floor(l.y)); psz = vec2(2.0, 1.0); }
    else if (k < 0.55) { pmin = vec2(floor(l.x), 0.0); psz = vec2(1.0, 2.0); }
    else               { pmin = floor(l); psz = vec2(1.0); }
    vec2 pc = pmin + psz * 0.5;
    vec2 lp = l - pc;                                      // position inside the panel
    vec2 pid = mc * 2.0 + pmin + seed;
    float kp = h21(pid);

    float px = dist * 0.0015 / unit + 0.004;               // ~1 screen pixel, in panel units
    float d = sdRound(lp, psz * 0.5 - 0.055, 0.07);
    float inP = smoothstep(px, -px, d);

    // panel face: tone variation, bevel lit from above-left
    // per-building hue: base teal, greener or bluer; plus a little per-panel drift
    float hb = h11(seed * 7.31 + 0.5);
    vec3 bc = hb < 0.4 ? PANEL : hb < 0.7 ? PANEL_A : PANEL_B;
    float drift = h21(pid + 3.3);
    bc = mix(bc, drift < 0.5 ? PANEL_A : PANEL_B, abs(drift - 0.5) * 0.5);
    vec3 face = mix(bc, bc * (PANEL_HI / PANEL), 0.25 + 0.5 * kp);
    float bev = smoothstep(-0.06, 0.0, d) * (lp.y > 0.0 ? 1.0 : -0.6);
    face *= 1.0 + 0.35 * bev;
    // vertical brushed gradient
    face *= 0.85 + 0.25 * (lp.y / psz.y + 0.5);

    // dark stencilled panels
    bool dark = kp > 0.82;
    if (dark) {
        face = GAP * 1.6 + PANEL * 0.15;
        int li = int(h11(kp * 37.0) * 6.0);
        int st = li == 0 ? T_C1 : li == 1 ? T_C2 : li == 2 ? T_C3 : li == 3 ? T_C4 : li == 4 ? T_C5 : T_C6;
        int n  = li == 0 ? N_C1 : li == 1 ? N_C2 : li == 2 ? N_C3 : li == 3 ? N_C4 : li == 4 ? N_C5 : N_C6;
        float fs = 0.032 * min(psz.x, psz.y) * (1.0 + step(1.5, psz.x));
        vec2 to = vec2(-psz.x * 0.5 + 0.12, -psz.y * 0.5 + 0.12);
        float on = textLine(floor((lp - to) / fs), st, n);
        if (psz.y > 1.5) {          // second line on tall panels
            int li2 = (li + 2) % 6;
            int st2 = li2 == 0 ? T_C1 : li2 == 1 ? T_C2 : li2 == 2 ? T_C3 : li2 == 3 ? T_C4 : li2 == 4 ? T_C5 : T_C6;
            int n2  = li2 == 0 ? N_C1 : li2 == 1 ? N_C2 : li2 == 2 ? N_C3 : li2 == 3 ? N_C4 : li2 == 4 ? N_C5 : N_C6;
            on = max(on, textLine(floor((lp - to - vec2(0.0, 10.0 * fs)) / fs), st2, n2));
        }
        face = mix(face, INK, on);
    }
    vec3 col = mix(GAP, face, inP);

    // indicator light, top-right corner
    vec2 ledP = lp - vec2(psz.x * 0.5 - 0.2, psz.y * 0.5 - 0.17);
    float led = smoothstep(px, -px, sdRound(ledP, vec2(0.06, 0.028), 0.01));
    float on = step(0.12, h21(pid + floor(T * 0.2 + kp * 5.0)));
    vec3 lc = h11(kp * 91.0) > 0.93 ? LED2 : LED;
    if (!dark || kp > 0.9) glow += lc * led * on * 1.6;
    // a few panels light up softly from inside
    if (kp < 0.05) glow += mix(PANEL_HI, FOG_FAR, 0.5) * inP * (0.5 + 0.5 * sin(T * 0.5 + kp * 99.0)) * 0.5;
    return col;
}

// floating dust motes at a few depths
vec3 motes(vec2 uv, float t) {
    vec3 c = vec3(0);
    for (int i = 0; i < 4; i++) {
        float depth = 2.0 + float(i) * 3.0;
        vec2 p = uv * depth * 1.4 + vec2(sin(t * 0.07 + float(i)) * 0.5, t * 0.05 * (1.0 + float(i) * 0.3));
        p.y += 0.0;
        vec2 cell = floor(p * 1.8), f = fract(p * 1.8) - 0.5;
        float k = h21(cell + float(i) * 13.0);
        if (k > 0.86) {
            vec2 off = vec2(h21(cell + 1.0), h21(cell + 2.0)) - 0.5;
            float r = 0.025 / (1.0 + float(i) * 0.4);
            float tw = 0.5 + 0.5 * sin(t * (0.5 + k) + k * 50.0);
            c += MOTE * smoothstep(r, 0.0, length(f - off * 0.6)) * tw * (0.6 / (1.0 + float(i) * 0.5));
        }
    }
    return c;
}

// ---- city layout (grid cells are 1x1 in x/z) ---------------------------
// random height of building `seg` in a row, snapped to STEP
float rawH(float seg, float side, float lane) {
    float k = h21(vec2(seg * 1.3 + side * 7.0, lane));
    float h = 9.0 + lane * 6.0 + k * (8.0 + lane * 8.0);           // rows behind are taller; front row stays above eye level
    return floor(h / STEP) * STEP;
}

// returns building height (0 = open), and an id for texturing
// Low blocks fill every gap (street, alleys, cross streets), like slabs:
// lanes 2 cells wide along z, cut into segments, 1..LOW_MAX storeys tall.
float lowH(vec2 c, out vec3 bid) {
    float lx = floor(c.x / 2.0);
    float L = 2.0 + floor(h11(lx * 5.3 + 0.2) * 4.0);
    float off = floor(h11(lx * 2.1 + 0.7) * 7.0);
    float seg = floor((c.y + off) / L);
    float k = h21(vec2(lx, seg) + 0.7);
    bid = vec3(lx, -1.0, seg);                                     // lane -1 marks a low block
    return STEP * (1.0 + floor(k * LOW_MAX));
}

float bldH(vec2 c, out vec3 bid) {
    bid = vec3(0);
    float ax = c.x + 0.5, side = sign(ax);
    float d = abs(ax) - NARROW;
    if (d < 0.0) return lowH(c, bid);                              // the street
    if (mod(c.y, CROSS_P) >= CROSS_P - CROSS_W) return lowH(c, bid); // cross street
    float lane = floor(d / LANE_W), lx = d - lane * LANE_W;
    if (lx > LANE_W - 1.0) return lowH(c, bid);                    // alley between rows
    float L = 3.0 + floor(h11(lane * 7.1 + side) * 4.0);           // building length 2..5 + alley
    float off = floor(h11(lane * 3.3 + side * 5.0) * 9.0);
    float zc = c.y + off;
    float seg = floor(zc / L), lz = zc - seg * L;
    if (lz > L - 1.0) return lowH(c, bid);                         // alley after every building
    bid = vec3(side, lane, seg);
    float h = rawH(seg, side, lane);
    // Odd buildings step away from both (unchanged) even neighbours so that
    // adjacent buildings in a row always differ by at least MIN_DH.
    if (mod(seg, 2.0) > 0.5) {
        float e1 = rawH(seg - 1.0, side, lane), e2 = rawH(seg + 1.0, side, lane);
        if (abs(h - e1) < MIN_DH || abs(h - e2) < MIN_DH) {
            float lo = min(e1, e2), hi = max(e1, e2);
            float up = hi + MIN_DH;                                // always possible
            float best = up;
            float down = lo - MIN_DH;
            if (down >= 9.0 + lane * 6.0 && h - down < up - h) best = down; // stay above the row's floor
            if (hi - lo >= 2.0 * MIN_DH) {                         // room in between
                float mid = clamp(h, lo + MIN_DH, hi - MIN_DH);
                if (abs(mid - h) < abs(best - h)) best = mid;
            }
            h = best;
        }
    }
    return clamp(h, 4.0, HMAX);
}

// ---- static far backdrop (depends only on view direction) ---------------
vec3 farSky(vec3 rd, vec3 col, vec3 fogCol) {
    float az = atan(rd.x, rd.z);                         // azimuth
    float el = rd.y / length(rd.xz);                     // elevation (tan)
    // hazy megastructures hanging in the mist
    for (int b = 0; b < 3; b++) {
        float fb = float(b);
        vec2 c = vec2(0.12 - 0.5 * fb + 0.9 * h11(fb + 3.0) * fb, 0.55 + 0.25 * h11(fb + 7.0));
        vec2 bp = vec2(az, el) - c;
        float blob = smoothstep(1.0, 0.0, length(bp * vec2(2.2 + fb, 3.5 + fb)));
        vec2 bg = abs(fract(vec2(az, el) * vec2(60.0, 40.0) + fb * 0.3) - 0.5);
        col = mix(col, FOGC * 0.55 + fogCol * 0.15, blob * (0.5 - fb * 0.1));
        col += fogCol * blob * step(0.42, max(bg.x, bg.y)) * 0.07;
        // hanging lights under the structures
        vec2 lg = vec2(az, el) * vec2(90.0, 90.0);
        float hl = step(0.93, h21(floor(lg) + fb)) * smoothstep(0.35, 0.1, length(fract(lg) - 0.5));
        col += mix(LED, FOG_FAR, 0.6) * hl * blob * 0.5 * (0.6 + 0.4 * sin(T * 0.7 + h21(floor(lg)) * 40.0));
    }
    // five layers of distant towers, farthest first
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float w = 0.018 + fi * 0.012;                    // column width in radians
        float cx = floor((az + fi * 0.37) / w);
        float fx = fract((az + fi * 0.37) / w);
        float k = h21(vec2(cx, fi * 13.0));
        float hgt = (0.03 + 0.34 * pow(h21(vec2(cx * 1.7, fi)), 1.4)) * (1.0 + fi * 0.3);
        // tower body (narrower than its column) + optional spire
        float body = step(0.1, k) * step(0.06, fx) * step(fx, 0.94) * step(el, hgt);
        float spire = step(0.75, k) * step(abs(fx - 0.5), 0.04) * step(el, hgt + 0.06 + 0.06 * k);
        // sky bridges between neighbouring towers
        float by = hgt * (0.4 + 0.3 * h21(vec2(cx, fi + 5.0)));
        float bridge = step(0.6, h21(vec2(cx, fi + 9.0))) * step(abs(el - by), 0.004 + 0.002 * fi) * step(el, hgt);
        float inside = max(max(body, spire), bridge) * step(-0.05, el);
        if (inside > 0.0) {
            vec3 bc = mix(fogCol, FOGC * (0.38 - fi * 0.05), 0.15 + 0.15 * fi);
            // facade grid + lit cells, denser on the nearer layers
            vec2 g = vec2(fx * (6.0 + fi * 2.0), el * (340.0 - fi * 40.0));   // roughly square cells
            vec2 gf = abs(fract(g) - 0.5);
            bc *= 0.82 + 0.18 * step(max(gf.x, gf.y), 0.36);
            float lit = step(0.965 - fi * 0.006, h21(floor(g) + cx * 3.0 + fi));
            vec3 lc = h21(floor(g) + 1.3) > 0.8 ? LED2 : mix(LED, FOG_FAR, 0.4);
            bc += lc * lit * (0.18 + 0.08 * fi) * body;
            // beacon on top of spires
            bc += LED2 * spire * step(hgt + 0.05 + 0.06 * k, el + 0.008) * step(0.5, fract(T * 0.4 + k * 9.0)) * 0.8;
            // bases sink into the black mist
            bc = mix(bc, LOW_FOG, smoothstep(hgt * 0.45, -0.02, el) * 0.85);
            col = bc;
        }
    }
    // specks of light drifting in the far mist
    vec2 sg = vec2(az * 140.0 + T * 0.05, el * 140.0);
    float sp = step(0.985, h21(floor(sg))) * smoothstep(0.3, 0.0, length(fract(sg) - 0.5));
    col += MOTE * sp * 0.25 * smoothstep(0.6, 0.0, el);
    return col;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    T = iTime;
    setTheme();
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;

    vec3 ro = vec3(sin(T * 0.05) * 0.3, EYE + sin(T * 0.3) * 0.03, T * SPEED);
    vec3 rd = normalize(vec3(uv.x, uv.y + 0.08, 1.05));

    // --- DDA over the x/z grid
    vec2 cell = floor(ro.xz);
    vec2 stp = sign(rd.xz);
    vec2 tDelta = abs(1.0 / rd.xz);
    vec2 tMax = ((cell + max(stp, 0.0)) - ro.xz) / rd.xz;
    float tEnter = 0.0;
    int axis = -1, face = -1;            // 0 roof, 1 x-facing wall, 2 z-facing wall, 3 ground
    float tHit = TMAX, h = 0.0;
    vec3 bid = vec3(0);
    for (int i = 0; i < 260; i++) {
        h = bldH(cell, bid);
        float yIn = ro.y + rd.y * tEnter;
        float tExit = min(tMax.x, tMax.y);
        if (h > 0.0 && yIn <= h && axis >= 0) { face = axis == 0 ? 1 : 2; tHit = tEnter; break; }
        float yOut = ro.y + rd.y * tExit;
        if (rd.y < 0.0 && yOut <= h) { tHit = (h - ro.y) / rd.y; face = h > 0.0 ? 0 : 3; break; }
        if (rd.y > 0.0 && yIn > HMAX) break;                       // above everything: sky
        if (tEnter > TMAX) break;
        tEnter = tExit;
        if (tMax.x < tMax.y) { tMax.x += tDelta.x; cell.x += stp.x; axis = 0; }
        else                 { tMax.y += tDelta.y; cell.y += stp.y; axis = 1; }
    }
    vec3 p = ro + rd * tHit;

    // light at the far end of the street: fog brightens looking down the street
    float toward = pow(max(rd.z, 0.0), 6.0) * smoothstep(0.5, 0.0, rd.y);
    vec3 fogCol = mix(FOGC, FOG_FAR, toward);
    vec3 col, glow = vec3(0);
    if (face < 0) {
        // sky: haze, brightest at the horizon down the street, with a static
        // far skyline and a huge hazy structure hanging in the mist
        col = mix(fogCol, FOGC * 0.35, smoothstep(0.0, 0.7, rd.y));
        col = farSky(rd, col, fogCol);
    } else {
        if (face == 3) {
            col = GAP * 1.5 + FOGC * 0.15;
            vec2 fg = abs(fract(p.xz * 0.5) - 0.5);
            col *= 0.8 + 0.2 * step(0.47, max(fg.x, fg.y));
        } else if (face == 0) {
            // roofs (mostly the low blocks): same panel cladding, laid flat
            float seed = bid.x * 3.0 + bid.y * 11.0 + bid.z * 0.37 + 5.0;
            col = panels(vec2(p.x, p.z), seed, 1.0, tHit, glow) * 0.9;
            col *= 1.0 / (1.0 + max(bid.y, 0.0) * 0.3);
        } else {
            float seed = bid.x * 3.0 + bid.y * 11.0 + bid.z * 0.37;
            float unit = bid.y < 0.5 ? 1.0 : 0.8;                 // finer panels on rows behind
            float lane = max(bid.y, 0.0);
            vec2 q = face == 1 ? vec2(-stp.x * p.z, p.y) : vec2(p.x, p.y);
            col = panels(q, seed, unit, tHit, glow);
            // darker higher up and toward the back rows, faces across alleys a bit darker
            col *= 1.05 - 0.5 * clamp(p.y / 30.0, 0.0, 1.0);
            col *= face == 2 ? 0.75 : 1.0;
            col *= 1.0 / (1.0 + lane * 0.3);
            col = mix(col, col.bgr * vec3(0.6, 1.0, 1.0), clamp(lane * 0.15, 0.0, 0.4));
        }
        col += glow;
        // distance fog (only distance: nothing is painted over)
        float fogA = 1.0 - exp(-tHit * FOG_D);
        col = mix(col, fogCol, fogA);
        // black mist at street level (same idea as city): fades by absolute
        // height, with a slowly drifting edge
        float n = vnoise(p.xz * 0.15 + vec2(T * 0.03, -T * 0.02)) - 0.5;
        float mist = pow(smoothstep(0.0, LOW_FOG_H, p.y + n * 1.5), LOW_FOG_POW);
        col = mix(LOW_FOG, col, mist);
    }
    col += motes(uv, T);

    vec2 v = fragCoord / iResolution.xy - 0.5;
    col *= 1.0 - dot(v, v) * 0.9;
    col += (h21(fragCoord + fract(T) * 91.0) - 0.5) * GRAIN;
    fragColor = vec4(max(col, 0.0), 1.0);
}
